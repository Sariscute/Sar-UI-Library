        Parent = self._leftScroll,
    }, { BackgroundColor3 = "Element" })
    corner(btn, 5)

    local indicator = create(self, "Frame", {
        Size = UDim2.fromOffset(3, 16),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BorderSizePixel = 0,
        Visible = false,
        Parent = btn,
    }, { BackgroundColor3 = "Accent" })

    local icon = makeIcon(self, {
        Size = UDim2.fromOffset(18, 18),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 12, 0.5, 0),
        Parent = btn,
    }, opts.Icon)

    local label = textLabel(self, {
        Text = title,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, icon and -44 or -20, 1, 0),
        Position = UDim2.new(0, icon and 38 or 14, 0, 0),
        Parent = btn,
    })

    local barFrame = create(self, "ScrollingFrame", {
        Name = "Bar_" .. title,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 8, 0, 0),
        Size = UDim2.new(1, -16, 1, -1),
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.X,
        ScrollingDirection = Enum.ScrollingDirection.X,
        Visible = false,
        Parent = self._chBar,
    })
    list(barFrame, 4, Enum.FillDirection.Horizontal, nil, Enum.VerticalAlignment.Center)

    tab._button = btn
    tab._indicator = indicator
    tab._icon = icon
    tab._label = label
    tab._bar = barFrame

    if not MOBILE then
        btn.MouseEnter:Connect(function()
            if self.SelectedTab ~= tab then
                tween(btn, { BackgroundTransparency = 0.6 }, 0.1)
            end
        end)
        btn.MouseLeave:Connect(function()
            if self.SelectedTab ~= tab then
                tween(btn, { BackgroundTransparency = 1 }, 0.1)
            end
        end)
    end
    btn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    self:_hook(tab, function()
        tab:_visual()
    end)

    table.insert(self.Tabs, tab)
    if not self.SelectedTab then
        self:SelectTab(tab)
    else
        tab:_visual()
    end
    return tab
end

function Window:SelectTab(tab)
    if type(tab) == "number" then
        tab = self.Tabs[tab]
    elseif type(tab) == "string" then
        for _, t in ipairs(self.Tabs) do
            if t.Title == tab then
                tab = t
                break
            end
        end
    end
    if type(tab) ~= "table" then
        return
    end
    local prev = self.SelectedTab
    self.SelectedTab = tab
    if prev and prev ~= tab then
        prev._bar.Visible = false
        if prev.SelectedChannel then
            prev.SelectedChannel._page.Visible = false
        end
        prev:_visual()
    end
    tab._bar.Visible = true
    if tab.SelectedChannel then
        tab.SelectedChannel._page.Visible = true
    end
    tab:_visual()
end

-- filters the tab list by tab name, channel name or any element text inside a tab.
-- jumps to the first matching tab when the current one doesn't match,
-- and shows "No results" when nothing matches. empty query restores everything.
function Window:Search(query)
    query = string.lower(query or "")
    local first, currentMatches = nil, false

    for _, tab in ipairs(self.Tabs) do
        local show = query == ""
        if not show then
            if string.find(string.lower(tab.Title), query, 1, true) then
                show = true
            else
                for _, ch in ipairs(tab.Channels) do
                    if string.find(string.lower(ch.Title), query, 1, true) then
                        show = true
                        break
                    end
                    for _, d in ipairs(ch._page:GetDescendants()) do
                        if d:IsA("TextLabel") and string.find(string.lower(d.Text), query, 1, true) then
                            show = true
                            break
                        end
                    end
                    if show then
                        break
                    end
                end
            end
        end
        tab._button.Visible = show
        if show then
            first = first or tab
            if tab == self.SelectedTab then
                currentMatches = true
            end
        end
    end

    if self._noResults then
        self._noResults.Visible = query ~= "" and first == nil
    end

    -- only jump if the tab you're on doesn't match, so the page doesn't flicker while typing
    if query ~= "" and first and not currentMatches then
        self:SelectTab(first)
    end
end

---------------------------------------------------------------- notify / dialog

function Window:Notify(opts)
    opts = norm(opts)
    local t = self.Theme
    local colors = { Info = t.Accent, Success = t.Success, Warning = t.Warning, Error = t.Danger }
    local color = colors[opts.Type or "Info"] or t.Accent
    local duration = opts.Duration or 4
    self._notifOrder += 1

    local wrap = create(self, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = self._notifOrder,
        Parent = self._notifHolder,
    })
    local card = create(self, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        Position = UDim2.new(1.2, 0, 0, 0),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = wrap,
    }, { BackgroundColor3 = "Element" })
    corner(card, 5)
    stroke(self, card, "Outline")

    create(self, "Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Parent = card,
    })
    local content = create(self, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = card,
    })
    pad(content, 16, 10, 12, 14)
    list(content, 3)
    textLabel(self, {
        Text = opts.Title or "Notification",
        Font = FONT_BOLD,
        TextWrapped = true,
        Size = UDim2.new(1, 0, 0, 16),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = content,
    }, "Text")
    if opts.Content and opts.Content ~= "" then
        textLabel(self, {
            Text = opts.Content,
            Font = FONT_REG,
            TextSize = 13,
            TextWrapped = true,
            Size = UDim2.new(1, 0, 0, 14),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 2,
            Parent = content,
        }, "SubText")
    end
    local timer = create(self, "Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Parent = card,
    })

    tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.3, Enum.EasingStyle.Quint)
    tween(timer, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)

    local dismissed = false
    local function dismiss()
        if dismissed then
            return
        end
        dismissed = true
        tween(card, { Position = UDim2.new(1.2, 0, 0, 0) }, 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.3, function()
            wrap:Destroy()
        end)
    end
    card.MouseButton1Click:Connect(dismiss)
    task.delay(duration, dismiss)
    return { Dismiss = dismiss }
end

function Window:Dialog(opts)
    opts = norm(opts)
    local t = self.Theme

    local overlay = create(self, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 50,
        Parent = self.Main,
    })
    tween(overlay, { BackgroundTransparency = 0.4 }, 0.2)

    -- fills the window minus a margin on small screens, never wider than opts.Width
    local card = create(self, "Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, -32, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        Parent = overlay,
    }, { BackgroundColor3 = "Element" })
    sizeMax(card, opts.Width or 340, math.huge)
    corner(card, 6)
    stroke(self, card, "Outline")
    pad(card, 18, 16, 18, 16)
    list(card, 8)

    textLabel(self, {
        Text = opts.Title or "Dialog",
        Font = FONT_BOLD,
        TextSize = 16,
        TextWrapped = true,
        Size = UDim2.new(1, 0, 0, 20),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = card,
    }, "Text")
    if opts.Content and opts.Content ~= "" then
        textLabel(self, {
            Text = opts.Content,
            Font = FONT_REG,
            TextSize = 14,
            TextWrapped = true,
            Size = UDim2.new(1, 0, 0, 16),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 2,
            Parent = card,
        }, "SubText")
    end

    local row = create(self, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, sz(34, 40)),
        LayoutOrder = 3,
        Parent = card,
    })
    list(row, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)

    local closed = false
    local function close()
        if closed then
            return
        end
        closed = true
        card.Visible = false
        tween(overlay, { BackgroundTransparency = 1 }, 0.15)
        task.delay(0.17, function()
            overlay:Destroy()
        end)
    end

    local buttons = opts.Buttons or { { Title = "OK", Variant = "Primary" } }
    for i, b in ipairs(buttons) do
        local variant = b.Variant or (i == #buttons and "Primary" or "Default")
        local bg, fg = t.Field, t.Text
        if variant == "Primary" then
            bg, fg = t.Accent, t.AccentText
        elseif variant == "Danger" then
            bg, fg = t.Danger, Color3.new(1, 1, 1)
        end
        local btn = create(self, "TextButton", {
            Text = b.Title or "OK",
            Font = FONT_MED,
            TextSize = 14,
            TextColor3 = fg,
            BackgroundColor3 = bg,
            AutoButtonColor = true,
            AutomaticSize = Enum.AutomaticSize.X,
            Size = UDim2.new(0, 0, 0, sz(32, 38)),
            BorderSizePixel = 0,
            LayoutOrder = i,
            Parent = row,
        })
        corner(btn, 4)
        pad(btn, 16, 0, 16, 0)
        btn.MouseButton1Click:Connect(function()
            close()
            fire(b.Callback)
        end)
    end

    return { Close = close }
end

---------------------------------------------------------------- window api

function Window:Toggle(state)
    if state == nil then
        state = not self.Visible
    end
    self.Visible = state
    self._toggleId = (self._toggleId or 0) + 1
    local id = self._toggleId
    local main, scale = self.Main, self._scale

    if self._openButton then
        self._openButton.Visible = (not state) and self._floating
    end

    -- drawers (compact layout) shouldn't still be open when the window comes back
    if not state and self._drawer then
        self._drawer = nil
        self:_placeDrawers(false)
    end

    for _, shadowSpec in ipairs(self._shadowFrames or {}) do
        tween(shadowSpec.Frame, {
            BackgroundTransparency = state and shadowSpec.Transparency or 1,
        }, state and 0.2 or 0.15, Enum.EasingStyle.Quad,
            state and Enum.EasingDirection.Out or Enum.EasingDirection.In)
    end

    if state then
        -- start from "hidden" values only if the window was fully hidden
        if not main.Visible then
            main.GroupTransparency = 1
            scale.Scale = 0.94
            main.Visible = true
        end
        tween(main, { GroupTransparency = 0 }, 0.2, Enum.EasingStyle.Quad)
        tween(scale, { Scale = 1 }, 0.25, Enum.EasingStyle.Quint)
    else
        tween(main, { GroupTransparency = 1 }, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tween(scale, { Scale = 0.94 }, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.17, function()
            -- ignore if the window was opened again or destroyed meanwhile
            if self._toggleId == id and not self._destroyed then
                main.Visible = false
            end
        end)
    end
end

function Window:SetTitle(text)
    self.Title = text
    self._titleLabel.Text = text
end

function Window:SetTheme(theme)
    local data
    if type(theme) == "string" then
        data = SAR.Themes[theme]
        if not data then
            return
        end
        self.ThemeName = theme
    elseif type(theme) == "table" then
        data = theme
