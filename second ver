function Window:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    for _, c in ipairs(self._conns) do
        c:Disconnect()
    end
    self._conns = {}
    local idx = table.find(SAR.Windows, self)
    if idx then
        table.remove(SAR.Windows, idx)
    end
    self.Gui:Destroy()
    fire(self._onDestroy)
end

---------------------------------------------------------------- responsive layout

-- window size in pixels (resolved against the screen, ignores the open animation scale)
function Window:_mainSize()
    local vs = viewportSize(self.Gui)
    local s = self.Main.Size
    return Vector2.new(s.X.Scale * vs.X + s.X.Offset, s.Y.Scale * vs.Y + s.Y.Offset)
end

-- profile card only shows when there is room for it
function Window:_refreshProfile()
    if not self._profile then
        return
    end
    local show = self._profileWanted ~= false and not self._compact and not self._short
    self._profile.Visible = show
    local bottom = show and PROFILE_H or (self._short and 0 or FOOTER_H)
    self._pages.Size = UDim2.new(1, 0, 1, -(41 + bottom))
end

-- slides the rails in / out (compact layout) and fades the scrim behind them
function Window:_placeDrawers(animate)
    local scrim = self._scrim
    if not scrim then
        return
    end
    if not self._compact then
        scrim.Visible = false
        return
    end

    local function place(rail, side)
        local open = self._drawer == side
        local w = rail.Size.X.Offset
        local fromRight = side == "Right"
        local openPos = UDim2.new(fromRight and 1 or 0, 0, 0, 0)
        local closedPos = UDim2.new(fromRight and 1 or 0, fromRight and w or -w, 0, 0)
        if open then
            rail.Visible = true
            if animate then
                tween(rail, { Position = openPos }, 0.24, Enum.EasingStyle.Quint)
            else
                rail.Position = openPos
            end
        elseif animate and rail.Visible then
            tween(rail, { Position = closedPos }, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.delay(0.2, function()
                if not self._destroyed and self._compact and self._drawer ~= side then
                    rail.Visible = false
                end
            end)
        else
            rail.Position = closedPos
            rail.Visible = false
        end
    end
    place(self._rightRail, "Right")

    if self._drawer then
        scrim.Visible = true
        if animate then
            tween(scrim, { BackgroundTransparency = 0.45 }, 0.2)
        else
            scrim.BackgroundTransparency = 0.45
        end
    elseif animate then
        tween(scrim, { BackgroundTransparency = 1 }, 0.18)
        task.delay(0.2, function()
            if not self._destroyed and self._drawer == nil then
                scrim.Visible = false
            end
        end)
    else
        scrim.BackgroundTransparency = 1
        scrim.Visible = false
    end
end

function Window:_setDrawer(side, state)
    if not self._compact then
        return
    end
    if state then
        self._drawer = side
    elseif self._drawer == side then
        self._drawer = nil
    else
        return
    end
    self:_placeDrawers(true)
end

function Window:_toggleDrawer(side)
    self:_setDrawer(side, self._drawer ~= side)
end

function Window:_closeDrawers()
    if self._drawer then
        self._drawer = nil
        self:_placeDrawers(true)
    end
end

-- picks between the desktop layout (tabs + content + quick rail) and the compact layout
-- (tabs stay visible but slimmer, the quick rail becomes a drawer). short windows (phone in
-- landscape) also drop the rail titles + footer to save height
function Window:_layout(force)
    if self._destroyed or not self._leftRail then
        return
    end

    local ms = self:_mainSize()
    local short = ms.Y < 480
    local compact
    if self._forceCompact ~= nil then
        compact = self._forceCompact
    else
        compact = ms.X < self._breakpoint
    end

    local changed = compact ~= self._compact or short ~= self._short
    self._compact, self._short = compact, short
    if not changed and not force then
        return
    end

    local LW, RW = self._LW, self._RW
    local left, right, mid, scrim = self._leftRail, self._rightRail, self._mid, self._scrim

    if compact then
        -- tabs stay on screen, just slimmer; the quick rail slides over the content
        local lw = math.clamp(math.floor(ms.X * 0.27), math.min(104, LW), LW)
        local rw = math.clamp(ms.X - 64, math.min(120, RW + 24), RW + 24)
        left.Size = UDim2.new(0, lw, 1, 0)
        left.Position = UDim2.new(0, 0, 0, 0)
        left.Visible = true
        left.ZIndex = 1
        right.Size = UDim2.new(0, rw, 1, 0)
        right.ZIndex = 10
        mid.Position = UDim2.new(0, lw, 0, 0)
        mid.Size = UDim2.new(1, -lw, 1, 0)
        self:_placeDrawers(false)
    else
        self._drawer = nil
        local lw, rw = LW, RW
        if short then
            lw, rw = math.min(LW, 148), math.min(RW, 148)
        end
        left.Size = UDim2.new(0, lw, 1, 0)
        right.Size = UDim2.new(0, rw, 1, 0)
        left.Position = UDim2.new(0, 0, 0, 0)
        right.Position = UDim2.new(1, 0, 0, 0)
        left.Visible = true
        right.Visible = true
        left.ZIndex = 1
        right.ZIndex = 1
        mid.Position = UDim2.new(0, lw, 0, 0)
        mid.Size = UDim2.new(1, -(lw + rw), 1, 0)
        scrim.Visible = false
        scrim.BackgroundTransparency = 1
    end

    if self._quickBtn then
        self._quickBtn.Visible = compact
    end
    if self._subtitlePill then
        self._subtitlePill.Visible = not compact
    end
    if self._shades and self._shades[2] then
        self._shades[2].Visible = compact
    end
    if self._grip then
        self._grip.Visible = self._resizable and not compact
    end

    -- short windows: hide the rail titles and the footer, pull the lists up
    for side, r in pairs(self._railUI or {}) do
        r.title.Visible = not short
        local y = short and (side == "Left" and 46 or 8) or r.y
        r.scroll.Position = UDim2.new(0, 0, 0, y)
        r.scroll.Size = UDim2.new(1, 0, 1, -y)
        if r.noResults then
            r.noResults.Position = UDim2.new(0, 8, 0, y + 8)
        end
    end
    if self._footer then
        self._footer.Visible = not short
    end
    self:_refreshProfile()
end

-- "Auto" (default), "Compact" or "Desktop"
function Window:SetLayout(mode)
    mode = string.lower(tostring(mode or "auto"))
    if mode == "compact" then
        self._forceCompact = true
    elseif mode == "desktop" then
        self._forceCompact = false
    else
        self._forceCompact = nil
    end
    self:_layout(true)
end

---------------------------------------------------------------- configs

function Window:_cfgFolder()
    return self.FolderName .. "/configs"
end

function Window:_cfgPath(name)
    return self:_cfgFolder() .. "/" .. name .. ".json"
end

function Window:ListConfigs()
    local out = {}
    if fsAvailable() and typeof(listfiles) == "function" then
        local ok, files = pcall(listfiles, self:_cfgFolder())
        if ok and type(files) == "table" then
            for _, p in ipairs(files) do
                local n = tostring(p):match("([^/\\]+)%.json$")
                if n then
                    table.insert(out, n)
                end
            end
        end
    end
    table.sort(out)
    return out
end

function Window:SaveConfig(name)
    name = (name and name ~= "") and name or "default"
    if not fsAvailable() then
        return false, "File functions are not available here"
    end
    local data = {}
    for flag, entry in pairs(self._flags) do
        local ok, v = pcall(function()
            return entry.el:Get()
        end)
        if ok then
            if v == nil and entry.kind == "Keybind" then
                data[flag] = { __t = "KeyCode" }
            elseif v ~= nil then
                data[flag] = encodeValue(v)
            end
        end
    end
    if typeof(makefolder) == "function" then
        pcall(makefolder, self.FolderName)
        pcall(makefolder, self:_cfgFolder())
    end
    local ok, err = pcall(writefile, self:_cfgPath(name), HttpService:JSONEncode(data))
    return ok, err
end

function Window:LoadConfig(name)
    name = (name and name ~= "") and name or "default"
    if not fsAvailable() then
        return false, "File functions are not available here"
    end
    local path = self:_cfgPath(name)
    if not isfile(path) then
        return false, "Config not found"
    end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not ok or type(data) ~= "table" then
        return false, "Invalid config file"
    end
    for flag, raw in pairs(data) do
        local entry = self._flags[flag]
        if entry then
            pcall(function()
                entry.el:Set(decodeValue(raw))
            end)
        end
    end
    return true
end

function Window:DeleteConfig(name)
    if not fsAvailable() or typeof(delfile) ~= "function" then
        return false, "File functions are not available here"
    end
    local path = self:_cfgPath(name)
    if not isfile(path) then
        return false, "Config not found"
    end
    return pcall(delfile, path)
end

