---------------------------------------------------------------- window internals

function Window:_bind(inst, map)
    local rec = self._themed[inst]
    if not rec then
        rec = {}
        self._themed[inst] = rec
    end
    for prop, key in pairs(map) do
        rec[prop] = key
        local c = self.Theme[key]
        if c ~= nil then
            inst[prop] = c
        end
    end
end

function Window:_hook(key, fn)
    self._hooks[key] = fn
end

function Window:_connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(self._conns, c)
    return c
end

function Window:_registerFlag(flag, el, kind)
    if flag then
        self._flags[flag] = { el = el, kind = kind }
    end
end

function Window:_setFlag(flag, value)
    if flag then
        self.Flags[flag] = value
    end
end

function Window:_applyTheme()
    for inst, rec in pairs(self._themed) do
        for prop, key in pairs(rec) do
            local c = self.Theme[key]
            if c ~= nil then
                tween(inst, { [prop] = c }, 0.2)
            end
        end
    end
    for _, fn in pairs(self._hooks) do
        pcall(fn)
    end
end

---------------------------------------------------------------- instance helpers

local function create(win, class, props, tmap)
    local inst = Instance.new(class)
    local parent
    for k, v in pairs(props) do
        if k == "Parent" then
            parent = v
        else
            inst[k] = v
        end
    end
    if tmap then
        win:_bind(inst, tmap)
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius or 5)
    c.Parent = parent
    return c
end

local function stroke(win, parent, key, thickness)
    local s = Instance.new("UIStroke")
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Thickness = thickness or 1
    win:_bind(s, { Color = key or "Outline" })
    s.Parent = parent
    return s
end

local function pad(parent, l, t, r, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingRight = UDim.new(0, r or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.Parent = parent
    return p
end

local function list(parent, gap, dir, h, v)
    local l = Instance.new("UIListLayout")
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Padding = UDim.new(0, gap or 0)
    l.FillDirection = dir or Enum.FillDirection.Vertical
    if h then
        l.HorizontalAlignment = h
    end
    if v then
        l.VerticalAlignment = v
    end
    l.Parent = parent
    return l
end

local function sizeMin(parent, x, y)
    local c = Instance.new("UISizeConstraint")
    c.MinSize = Vector2.new(x, y)
    c.Parent = parent
    return c
end

local function sizeMax(parent, x, y)
    local c = Instance.new("UISizeConstraint")
    c.MaxSize = Vector2.new(x, y)
    c.Parent = parent
    return c
end

local function textLabel(win, props, colorKey)
    props.BackgroundTransparency = 1
    props.BorderSizePixel = 0
    props.Font = props.Font or FONT_MED
    props.TextSize = props.TextSize or 14
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    return create(win, "TextLabel", props, colorKey and { TextColor3 = colorKey } or nil)
end

-- small thin bar, used to draw the icons below (no images or emoji needed)
local function bar(win, parent, w, h, x, y, rot, colorKey)
    return create(win, "Frame", {
        Size = UDim2.fromOffset(w, h),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(x, y),
        Rotation = rot,
        BorderSizePixel = 0,
        Parent = parent,
    }, { BackgroundColor3 = colorKey })
end

-- "v" shaped arrow, rotate the returned frame for the other directions
local function chevron(win, props, colorKey)
    props.BackgroundTransparency = 1
    props.BorderSizePixel = 0
    props.Size = props.Size or UDim2.fromOffset(12, 12)
    local box = create(win, "Frame", props)
    bar(win, box, 6, 2, 4, 6, 45, colorKey)
    bar(win, box, 6, 2, 8, 6, -45, colorKey)
    return box
end

local function checkMark(win, props, colorKey)
    props.BackgroundTransparency = 1
    props.BorderSizePixel = 0
    props.Size = UDim2.fromOffset(12, 12)
    local box = create(win, "Frame", props)
    bar(win, box, 4, 2, 3.25, 7.75, 45, colorKey)
    bar(win, box, 8, 2, 7.25, 6.25, -45, colorKey)
    return box
end

-- tab icon: asset id (number / "123" / "rbxassetid://123") or a short text glyph
local function makeIcon(win, props, icon)
    if icon == nil or icon == "" then
        return nil
    end
    local s = tostring(icon)
    props.BackgroundTransparency = 1
    props.BorderSizePixel = 0
    if s:match("^%d+$") or s:find("rbxasset", 1, true) then
        if s:match("^%d+$") then
            s = "rbxassetid://" .. s
        end
        props.Image = s
        return create(win, "ImageLabel", props)
    end
    props.Text = s
    props.Font = props.Font or FONT_BOLD
    props.TextSize = props.TextSize or 16
    return create(win, "TextLabel", props)
end

local function setIconColor(icon, color)
    if not icon then
        return
    end
    if icon:IsA("ImageLabel") then
        icon.ImageColor3 = color
    else
        icon.TextColor3 = color
    end
end

-- onStart can return false to cancel the drag, returns a function telling if a drag is active.
-- on touch the closest ScrollingFrame is frozen while dragging, otherwise sliders and color
-- pickers would scroll the page instead of following the finger
local function bindDrag(win, hit, onMove, onStart)
    local dragging = false
    local frozen = nil

    local function unfreeze()
        if frozen then
            pcall(function()
                frozen.ScrollingEnabled = true
            end)
            frozen = nil
        end
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local start = onStart or onMove
            if start(input.Position) == false then
                return
            end
            dragging = true
            if input.UserInputType == Enum.UserInputType.Touch then
                local sf = hit:FindFirstAncestorWhichIsA("ScrollingFrame")
                if sf and sf.ScrollingEnabled then
                    sf.ScrollingEnabled = false
                    frozen = sf
                end
            end
        end
    end)
    win:_connect(UserInputService.InputChanged, function(input)
        if
            dragging
            and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
        then
            onMove(input.Position)
        end
    end)
    win:_connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            unfreeze()
        end
    end)
    hit.Destroying:Connect(unfreeze)
    return function()
        return dragging
    end
end

-- no hover on touch devices (MouseEnter fires on tap there and MouseLeave never comes)
local function hoverEffect(win, button, base, over)
    if MOBILE then
        return
    end
    base = base or "Element"
    over = over or "ElementHover"
    button.MouseEnter:Connect(function()
        tween(button, { BackgroundColor3 = win.Theme[over] }, 0.12)
    end)
    button.MouseLeave:Connect(function()
        tween(button, { BackgroundColor3 = win.Theme[base] }, 0.12)
    end)
end

local KEY_SHORT = {
    LeftShift = "LShift", RightShift = "RShift",
    LeftControl = "LCtrl", RightControl = "RCtrl",
    LeftAlt = "LAlt", RightAlt = "RAlt",
    Backspace = "Bksp", Return = "Enter", Escape = "Esc", Backquote = "`",
    One = "1", Two = "2", Three = "3", Four = "4", Five = "5",
    Six = "6", Seven = "7", Eight = "8", Nine = "9", Zero = "0",
}

local KEY_CHIP_W = 96 -- header space reserved for the chip

local function keyName(key)
    if not key then
        return "none"
    end
    return KEY_SHORT[key.Name] or key.Name
end

local function toKeyCode(k)
    if typeof(k) == "EnumItem" then
        return k
    end
    if type(k) == "string" then
        local ok, v = pcall(function()
            return Enum.KeyCode[k]
        end)
        if ok then
            return v
        end
    end
    return nil
end

-- adds the key chip to a card header and wires the key press.
-- offset   : pixels from the right edge of the header where the chip sits
-- handlers : { Modes = bool, Press = fn(mode), Release = fn() }
-- the chip is hidden on devices without a keyboard, the key logic still works
local function attachKeybind(win, el, opts, offset, handlers)
    local key = toKeyCode(opts.Keybind)
    local mode = (handlers.Modes and opts.KeybindMode == "Hold") and "Hold" or "Toggle"
    local listening = false
    local held = false
    local keyFlag = opts.Flag and (opts.Flag .. "_key") or nil
    local modeFlag = opts.Flag and (opts.Flag .. "_mode") or nil

    local chip = create(win, "TextButton", {
        Text = "",
        Font = FONT_MED,
        TextSize = 12,
        AutoButtonColor = false,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.fromOffset(0, 20),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -offset, 0.5, 0),
        BorderSizePixel = 0,
        Visible = not MOBILE,
        Parent = el.Header,
    }, { BackgroundColor3 = "Field" })
    corner(chip, 4)
    stroke(win, chip, "Outline")
    pad(chip, 8, 0, 8, 0)
    sizeMin(chip, 36, 20)

    local function render()
        local t = win.Theme
        if listening then
            chip.Text = "..."
            chip.TextColor3 = t.Accent
        else
            local txt = keyName(key)
            if key and mode == "Hold" then
                txt = txt .. " (hold)"
            end
            chip.Text = txt
            chip.TextColor3 = key and t.Text or t.SubText
        end
    end
    render()
    win:_hook(chip, render)

    local function stopListening()
        listening = false
        render()
        if win._bindingOwner == chip then
            win._bindingOwner = nil
            win._cancelBinding = nil
            task.defer(function()
                if win._bindingOwner == nil then
                    win._binding = false
                end
            end)
        end
    end

    local function releaseIfHeld()
        if held then
            held = false
            handlers.Release()
        end
    end

    function el:SetKey(k, silent)
        releaseIfHeld()
        key = toKeyCode(k)
        stopListening()
        win:_setFlag(keyFlag, key)
        if not silent then
            fire(opts.KeybindChanged, key)
        end
    end
    function el:GetKey()
        return key
    end
    function el:SetKeybindMode(m, silent)
        if not handlers.Modes then
            return
        end
        releaseIfHeld()
        mode = (m == "Hold") and "Hold" or "Toggle"
        render()
        win:_setFlag(modeFlag, mode)
    end
    function el:GetKeybindMode()
        return mode
    end

    -- left click = listen, right click = switch mode
    chip.MouseButton1Click:Connect(function()
        if el.Locked then
            return
        end
        if listening and win._bindingOwner == chip then
            stopListening()
            return
        end
        if type(win._cancelBinding) == "function" then
            win._cancelBinding()
        end
        listening = true
        win._bindingOwner = chip
        win._binding = true
        win._cancelBinding = stopListening
        render()
    end)
    if handlers.Modes then
        chip.MouseButton2Click:Connect(function()
            if el.Locked then
                return
            end
            el:SetKeybindMode(mode == "Toggle" and "Hold" or "Toggle")
        end)
    end

    win:_connect(UserInputService.InputBegan, function(input, processed)
        if listening then
            if win._bindingOwner ~= chip then
                stopListening()
                return
            end
            -- Non-keyboard input must not end an active key capture.
            if input.UserInputType ~= Enum.UserInputType.Keyboard then
                return
            end
            local kc = input.KeyCode
            if kc == Enum.KeyCode.Escape then
                stopListening()
            elseif kc == Enum.KeyCode.Backspace or kc == Enum.KeyCode.Delete then
                el:SetKey(nil)
            elseif kc == win.ToggleKey then
                stopListening()
                win:Notify({
                    Title = "Key already in use",
                    Content = kc.Name .. " toggles the window.",
                    Type = "Warning",
                    Duration = 3,
                })
            else
                el:SetKey(kc)
            end
            return
        end

        if processed or win._binding or el.Locked or not key or input.KeyCode ~= key then
            return
        end
        if handlers.Modes and mode == "Hold" then
            held = true
        end
        handlers.Press(mode)
    end)

    win:_connect(UserInputService.InputEnded, function(input)
        if held and input.KeyCode == key then
            held = false
            handlers.Release()
        end
    end)

    -- save key + mode in configs
    if keyFlag then
        win:_registerFlag(keyFlag, {
            Get = function()
                return key
            end,
            Set = function(_, v)
                el:SetKey(v, true)
            end,
        }, "Keybind")
        win:_setFlag(keyFlag, key)
    end
    if modeFlag and handlers.Modes then
        win:_registerFlag(modeFlag, {
            Get = function()
                return mode
            end,
            Set = function(_, v)
                el:SetKeybindMode(v, true)
            end,
        }, "Mode")
        win:_setFlag(modeFlag, mode)
    end
end

---------------------------------------------------------------- element base

function Element:SetTitle(text)
    self._title.Text = text or ""
    self._title.Visible = (text or "") ~= ""
end

function Element:SetDesc(text)
    text = text or ""
    if not self._desc then
        if text == "" then
            return
        end
        self._desc = textLabel(self.Window, {
            Font = FONT_REG,
            TextSize = 13,
            TextWrapped = true,
            Size = UDim2.new(1, 0, 0, 14),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 2,
            Parent = self._holder,
        }, "SubText")
    end
    self._desc.Text = text
    self._desc.Visible = text ~= ""
end

function Element:SetVisible(state)
    self.Frame.Visible = state
end

function Element:SetLocked(state)
    self.Locked = state and true or false
    local a = self.Locked and 0.5 or 0
    self._title.TextTransparency = a
    if self._desc then
        self._desc.TextTransparency = a
    end
end

function Element:Destroy()
    self.Window._hooks[self] = nil
    self.Frame:Destroy()
end

-- standard card: header row (text left, control right) + extra rows below (LayoutOrder >= 2)
local function newCard(container, opts)
    local win = container.Window
    local clickable = opts.Clickable == true

    local card = create(win, clickable and "TextButton" or "Frame", {
        Name = "Card",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        LayoutOrder = container:_next(),
        Parent = container.Frame,
    }, { BackgroundColor3 = "Element" })
    if clickable then
        card.Text = ""
        card.AutoButtonColor = false
    end
    corner(card, 5)
    stroke(win, card, "Outline")
    pad(card, 12, 10, 12, 10)
    list(card, 8)
    sizeMin(card, 0, sz(42, 48))

    local header = create(win, "Frame", {
        Name = "Header",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = card,
    })
    sizeMin(header, 0, sz(22, 26))

    local holder = create(win, "Frame", {
        Name = "Text",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, -(opts.RightWidth or 0), 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = header,
    })
    list(holder, 2)

    local title = textLabel(win, {
        Text = opts.Title or "",
        Visible = (opts.Title or "") ~= "",
        TextWrapped = true,
        Size = UDim2.new(1, 0, 0, 16),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = holder,
    }, "Text")

    local el = setmetatable({
        Window = win,
        Frame = card,
        Header = header,
        Locked = opts.Locked == true,
        _title = title,
        _holder = holder,
    }, Element)

    if opts.Desc and opts.Desc ~= "" then
        el:SetDesc(opts.Desc)
    end
    if el.Locked then
        el:SetLocked(true)
    end
    return el
end

local function finalize(win, el, opts, value, kind)
    win:_registerFlag(opts.Flag, el, kind)
    win:_setFlag(opts.Flag, value)
    if opts.Default ~= nil and opts.CallOnCreate ~= false then
        task.defer(fire, opts.Callback, value)
    end
end

---------------------------------------------------------------- container

function Container:_next()
    self._order += 1
    return self._order
end

local function newContainer(win, frame, class)
    return setmetatable({ Window = win, Frame = frame, _order = 0 }, class or Container)
end

-- Label
function Container:Label(opts)
    opts = norm(opts)
    local win = self.Window
    local lbl = textLabel(win, {
        Text = opts.Title or opts.Text or "",
        Font = FONT_REG,
        TextSize = 13,
        TextWrapped = true,
        Size = UDim2.new(1, 0, 0, 16),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = self:_next(),
        Parent = self.Frame,
    }, "SubText")
    local el = { Window = win, Frame = lbl }
    function el:Set(text)
        lbl.Text = text
    end
    function el:SetVisible(state)
        lbl.Visible = state
    end
    function el:Destroy()
        lbl:Destroy()
    end
    return el
end

-- Paragraph
function Container:Paragraph(opts)
    opts = norm(opts)
    return newCard(self, { Title = opts.Title, Desc = opts.Content or opts.Desc })
end

-- Divider
function Container:Divider()
    local win = self.Window
    local line = create(win, "Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        BorderSizePixel = 0,
        LayoutOrder = self:_next(),
        Parent = self.Frame,
    }, { BackgroundColor3 = "Outline" })
    return { Frame = line, Destroy = function() line:Destroy() end }
end

-- Button
function Container:Button(opts)
    opts = norm(opts)
    local win = self.Window
    local hasKey = opts.Keybind ~= nil and opts.Keybind ~= false
    local showKey = hasKey and not MOBILE
    local el = newCard(self, {
        Title = opts.Title,
        Desc = opts.Desc,
        Clickable = true,
        RightWidth = 24 + (showKey and KEY_CHIP_W or 0),
        Locked = opts.Locked,
    })
    local card = el.Frame

    local arrow = chevron(win, {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -4, 0.5, 0),
        Rotation = -90,
        Parent = el.Header,
    }, "Accent")

    local function press()
        if el.Locked then
            return
        end
        local t = win.Theme
        card.BackgroundColor3 = t.Element:Lerp(t.Accent, 0.3)
        tween(card, { BackgroundColor3 = t.ElementHover }, 0.25)
        fire(opts.Callback)
    end

    hoverEffect(win, card)
    card.MouseButton1Click:Connect(press)

    if hasKey then
        attachKeybind(win, el, opts, 28, {
            Press = press,
            Release = function() end,
        })
    end

    function el:SetCallback(fn)
        opts.Callback = fn
    end
    return el
end

-- Toggle
function Container:Toggle(opts)
    opts = norm(opts)
    local win = self.Window
    local hasKey = opts.Keybind ~= nil and opts.Keybind ~= false
    local showKey = hasKey and not MOBILE

    -- bigger switch on touch devices
    local trackW, trackH, knobS = 36, 18, 12
    if MOBILE then
        trackW, trackH, knobS = 44, 24, 18
    end

    local el = newCard(self, {
        Title = opts.Title,
        Desc = opts.Desc,
        Clickable = true,
        RightWidth = trackW + 14 + (showKey and KEY_CHIP_W or 0),
        Locked = opts.Locked,
    })

    local track = create(win, "Frame", {
        Size = UDim2.fromOffset(trackW, trackH),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        BorderSizePixel = 0,
        Parent = el.Header,
    })
    corner(track, 4)
    local knob = create(win, "Frame", {
        Size = UDim2.fromOffset(knobS, knobS),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(knob, MOBILE and 4 or 3)

    el.Value = opts.Default == true

    local function apply(animate)
        local col = el.Value and win.Theme.Accent or win.Theme.Track
        local pos = el.Value and UDim2.new(1, -(knobS + 3), 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
        if animate then
            tween(track, { BackgroundColor3 = col }, 0.15)
            tween(knob, { Position = pos }, 0.15)
        else
            track.BackgroundColor3 = col
            knob.Position = pos
        end
    end
    apply(false)
    win:_hook(el, function()
        apply(false)
    end)

    function el:Set(value, silent)
        self.Value = value and true or false
        apply(true)
        win:_setFlag(opts.Flag, self.Value)
        if not silent then
            fire(opts.Callback, self.Value)
        end
    end
    function el:Get()
        return self.Value
    end

    hoverEffect(win, el.Frame)
    el.Frame.MouseButton1Click:Connect(function()
        if el.Locked then
            return
        end
        el:Set(not el.Value)
    end)

    if hasKey then
        attachKeybind(win, el, opts, trackW + 8, {
            Modes = true,
            Press = function(mode)
                if mode == "Hold" then
                    el:Set(true)
                else
                    el:Set(not el.Value)
                end
            end,
            Release = function()
                el:Set(false)
            end,
        })
    end

    finalize(win, el, opts, el.Value)
    return el
end

-- Slider
function Container:Slider(opts)
    opts = norm(opts)
    local win = self.Window
    local min = opts.Min or 0
    local max = opts.Max or 100
    local inc = opts.Increment or 1
    local suffix = opts.Suffix or ""
    local frac = tostring(inc):match("%.(%d+)")
    local decimals = frac and #frac or 0
    local fmt = "%." .. decimals .. "f"

    local el = newCard(self, { Title = opts.Title, Desc = opts.Desc, Locked = opts.Locked })

    local rowH = sz(20, 30)
    local knobS = sz(12, 18)

    local row = create(win, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, rowH),
        LayoutOrder = 2,
        Parent = el.Frame,
    })
    local valueLabel = textLabel(win, {
        Size = UDim2.new(0, 64, 1, 0),
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextSize = 13,
        Parent = row,
    }, "SubText")
    local hit = create(win, "TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -72, 1, 0),
        Parent = row,
    })
    local track = create(win, "Frame", {
        Size = UDim2.new(1, 0, 0, sz(4, 6)),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BorderSizePixel = 0,
        Parent = hit,
    }, { BackgroundColor3 = "Track" })
    corner(track, 2)
    local fill = create(win, "Frame", {
        Size = UDim2.fromScale(0, 1),
        BorderSizePixel = 0,
        Parent = track,
    }, { BackgroundColor3 = "Accent" })
    corner(fill, 2)
    local knob = create(win, "Frame", {
        Size = UDim2.fromOffset(knobS, knobS),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = fill,
    })
    corner(knob, MOBILE and 5 or 3)

    local function snap(v)
        v = math.clamp(v, min, max)
        v = min + math.floor((v - min) / inc + 0.5) * inc
        v = math.clamp(v, min, max)
        return tonumber(string.format(fmt, v))
    end

    el.Value = snap(opts.Default or min)

    local isDragging = false
    local function render(animate)
        local a = (max == min) and 0 or (el.Value - min) / (max - min)
        if animate then
            tween(fill, { Size = UDim2.fromScale(a, 1) }, 0.1)
        else
            fill.Size = UDim2.fromScale(a, 1)
        end
        valueLabel.Text = string.format(fmt, el.Value) .. suffix
    end
    render(false)

    function el:Set(value, silent)
        value = snap(tonumber(value) or min)
        local changed = value ~= self.Value
        self.Value = value
        render(not isDragging)
        win:_setFlag(opts.Flag, value)
        if changed and not silent then
            fire(opts.Callback, value)
        end
    end
    function el:Get()
        return self.Value
    end

    local function fromPos(pos)
        if el.Locked then
            return false
        end
        local a = math.clamp((pos.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        el:Set(min + (max - min) * a)
    end
    local getDragging = bindDrag(win, hit, fromPos)
    win:_connect(RunService.Heartbeat, function()
        isDragging = getDragging()
    end)

    finalize(win, el, opts, el.Value)
    return el
end

-- Dropdown
function Container:Dropdown(opts)
    opts = norm(opts)
    local win = self.Window
    local multi = opts.Multi == true
    local placeholder = opts.Placeholder or "none"

    local values = {}
    for _, v in ipairs(opts.Values or {}) do
        table.insert(values, tostring(v))
    end

    local el = newCard(self, { Title = opts.Title, Desc = opts.Desc, Locked = opts.Locked })

    local optH = sz(26, 34)
    local maxListH = sz(150, 176)

    local select = create(win, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, sz(30, 38)),
        BorderSizePixel = 0,
        LayoutOrder = 2,
        Parent = el.Frame,
    }, { BackgroundColor3 = "Field" })
    corner(select, 4)
    stroke(win, select, "Outline")

    local selText = textLabel(win, {
        TextSize = 13,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -34, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        Parent = select,
    }, "Text")
    local arrow = chevron(win, {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -16, 0.5, 0),
        Parent = select,
    }, "SubText")

    local listHolder = create(win, "Frame", {
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Size = UDim2.new(1, 0, 0, 0),
        Visible = false,
        LayoutOrder = 3,
        Parent = el.Frame,
    })
    local scroll = create(win, "ScrollingFrame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ScrollBarThickness = 2,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = listHolder,
    }, { ScrollBarImageColor3 = "Accent" })
    list(scroll, 3)

    el.Value = multi and {} or nil

    local optionButtons = {}
    local open = false

    local function listHeight()
        local n = #values
        return math.min(n * optH + math.max(n - 1, 0) * 3, maxListH)
    end

    local function isSelected(v)
        if multi then
            return table.find(el.Value, v) ~= nil
        end
        return el.Value == v
    end

    local function hasValue()
        if multi then
            return #el.Value > 0
        end
        return el.Value ~= nil
    end

    local function updateText()
        if multi then
            selText.Text = #el.Value > 0 and table.concat(el.Value, ", ") or placeholder
        else
            selText.Text = el.Value or placeholder
        end
        selText.TextColor3 = hasValue() and win.Theme.Text or win.Theme.SubText
    end

    local function updateVisual()
        local t = win.Theme
        for v, o in pairs(optionButtons) do
            local sel = isSelected(v)
            o.Label.TextColor3 = sel and t.Accent or t.Text
            o.Check.Visible = sel
            o.Btn.BackgroundTransparency = sel and 0 or 1
        end
    end

    local function setOpen(state)
        if state and el.Locked then
            return
        end
        open = state
        if state then
            listHolder.Visible = true
            listHolder.Size = UDim2.new(1, 0, 0, 0)
            tween(listHolder, { Size = UDim2.new(1, 0, 0, listHeight()) }, 0.18)
        else
            tween(listHolder, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
            task.delay(0.17, function()
                if not open then
                    listHolder.Visible = false
                end
            end)
        end
        tween(arrow, { Rotation = state and 180 or 0 }, 0.18)
    end

    local function copyValue()
        return multi and table.clone(el.Value) or el.Value
    end

    function el:Set(value, silent)
        if multi then
            local set = {}
            if type(value) == "table" then
                for _, v in ipairs(value) do
                    set[tostring(v)] = true
                end
            elseif value ~= nil then
                set[tostring(value)] = true
            end
            local out = {}
            for _, v in ipairs(values) do
                if set[v] then
                    table.insert(out, v)
                end
            end
            self.Value = out
        else
            if value ~= nil then
                value = tostring(value)
                if not table.find(values, value) then
                    value = nil
                end
            end
            self.Value = value
        end
        updateText()
        updateVisual()
        win:_setFlag(opts.Flag, copyValue())
        if not silent then
            fire(opts.Callback, copyValue())
        end
    end
    function el:Get()
        return copyValue()
    end

    local function build()
        for _, o in pairs(optionButtons) do
            o.Btn:Destroy()
        end
        optionButtons = {}
        for i, v in ipairs(values) do
            local btn = create(win, "TextButton", {
                Text = "",
                AutoButtonColor = false,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -4, 0, optH),
                BorderSizePixel = 0,
                LayoutOrder = i,
                Parent = scroll,
            }, { BackgroundColor3 = "Field" })
            corner(btn, 3)
            local lbl = textLabel(win, {
                Text = v,
                TextSize = 13,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Size = UDim2.new(1, -30, 1, 0),
                Position = UDim2.new(0, 8, 0, 0),
                Parent = btn,
            }, "Text")
            local check = checkMark(win, {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(1, -14, 0.5, 0),
                Visible = false,
                Parent = btn,
            }, "Accent")
            optionButtons[v] = { Btn = btn, Label = lbl, Check = check }

            if not MOBILE then
                btn.MouseEnter:Connect(function()
                    if not isSelected(v) then
                        tween(btn, { BackgroundTransparency = 0.5 }, 0.1)
                    end
                end)
                btn.MouseLeave:Connect(function()
                    if not isSelected(v) then
                        tween(btn, { BackgroundTransparency = 1 }, 0.1)
                    end
                end)
            end
            btn.MouseButton1Click:Connect(function()
                if multi then
                    local cur = table.clone(el.Value)
                    local idx = table.find(cur, v)
                    if idx then
                        table.remove(cur, idx)
                    else
                        table.insert(cur, v)
                    end
                    el:Set(cur)
                else
                    el:Set(v)
                    setOpen(false)
                end
            end)
        end
        if open then
            listHolder.Size = UDim2.new(1, 0, 0, listHeight())
        end
        updateVisual()
    end

    function el:Refresh(newValues, keepSelection)
        values = {}
        for _, v in ipairs(newValues or {}) do
            table.insert(values, tostring(v))
        end
        local previous = copyValue()
        build()
        if keepSelection then
            self:Set(previous, true)
        else
            self:Set(multi and {} or nil, true)
        end
    end

    select.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)
    hoverEffect(win, select, "Field", "ElementHover")

    build()
    win:_hook(el, function()
        updateText()
        updateVisual()
    end)

    if opts.Default ~= nil then
        el:Set(opts.Default, true)
    else
        updateText()
    end

    finalize(win, el, opts, copyValue())
    return el
end

-- Input
function Container:Input(opts)
    opts = norm(opts)
    local win = self.Window
    local multiline = opts.MultiLine == true

    local el = newCard(self, { Title = opts.Title, Desc = opts.Desc, Locked = opts.Locked })

    local field = create(win, "Frame", {
        Size = UDim2.new(1, 0, 0, multiline and sz(80, 96) or sz(30, 38)),
        BorderSizePixel = 0,
        LayoutOrder = 2,
        Parent = el.Frame,
    }, { BackgroundColor3 = "Field" })
    corner(field, 4)
    local fieldStroke = stroke(win, field, "Outline")

    local box = create(win, "TextBox", {
        Text = opts.Default or "",
        PlaceholderText = opts.Placeholder or "",
        ClearTextOnFocus = opts.ClearTextOnFocus == true,
        MultiLine = multiline,
        TextWrapped = multiline,
        TextEditable = not el.Locked,
        Font = FONT_REG,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Size = UDim2.new(1, -20, 1, multiline and -12 or 0),
        Position = UDim2.new(0, 10, 0, multiline and 6 or 0),
        Parent = field,
    }, { TextColor3 = "Text", PlaceholderColor3 = "SubText" })

    el.Value = box.Text

    box.Focused:Connect(function()
        tween(fieldStroke, { Color = win.Theme.Accent }, 0.12)
    end)

    if opts.Numeric then
        box:GetPropertyChangedSignal("Text"):Connect(function()
            local cleaned = (box.Text:gsub("[^%d%.%-]", ""))
            if cleaned ~= box.Text then
                box.Text = cleaned
            end
        end)
    end

    box.FocusLost:Connect(function(enterPressed)
        tween(fieldStroke, { Color = win.Theme.Outline }, 0.12)
        if el.Locked then
            return
        end
        if opts.OnEnterOnly and not enterPressed then
            return
        end
        el.Value = box.Text
        win:_setFlag(opts.Flag, el.Value)
        fire(opts.Callback, el.Value)
    end)

    function el:Set(text, silent)
        text = tostring(text or "")
        box.Text = text
        self.Value = text
        win:_setFlag(opts.Flag, text)
        if not silent then
            fire(opts.Callback, text)
        end
    end
    function el:Get()
        return self.Value
    end
    function el:SetLocked(state)
        Element.SetLocked(self, state)
        box.TextEditable = not self.Locked
    end

    finalize(win, el, opts, el.Value)
    return el
end

-- Keybind
function Container:Keybind(opts)
    opts = norm(opts)
    local win = self.Window
    local el = newCard(self, { Title = opts.Title, Desc = opts.Desc, RightWidth = 88, Locked = opts.Locked })

    local btn = create(win, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.fromOffset(76, sz(22, 28)),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        BorderSizePixel = 0,
        Parent = el.Header,
    }, { BackgroundColor3 = "Field" })
    corner(btn, 4)
    stroke(win, btn, "Outline")
    local txt = textLabel(win, {
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.fromScale(1, 1),
        Parent = btn,
    }, "Text")

    local default = opts.Default
    if type(default) == "string" then
        default = Enum.KeyCode[default]
    end
    el.Value = default

    local listening = false
    local function render()
        txt.Text = listening and "..." or (el.Value and el.Value.Name or "none")
    end
    render()

    local function stopListening()
        listening = false
        render()
        if win._bindingOwner == el then
            win._bindingOwner = nil
            win._cancelBinding = nil
            task.defer(function()
                if win._bindingOwner == nil then
                    win._binding = false
                end
            end)
        end
    end

    function el:Set(key, silent)
        if type(key) == "string" then
            key = Enum.KeyCode[key]
        end
        self.Value = key
        stopListening()
        win:_setFlag(opts.Flag, key)
        if not silent then
            fire(opts.ChangedCallback, key)
        end
    end
    function el:Get()
        return self.Value
    end

    hoverEffect(win, btn, "Field", "ElementHover")
    btn.MouseButton1Click:Connect(function()
        if el.Locked then
            return
        end
        if listening and win._bindingOwner == el then
            render()
            return
        end
        if type(win._cancelBinding) == "function" then
            win._cancelBinding()
        end
        listening = true
        win._bindingOwner = el
        win._binding = true
        win._cancelBinding = stopListening
        render()
    end)

    win:_connect(UserInputService.InputBegan, function(input, processed)
        if listening then
            if win._bindingOwner ~= el then
                stopListening()
                return
            end
            -- Keep listening through mouse/touch input; only keyboard input binds a key.
            if input.UserInputType ~= Enum.UserInputType.Keyboard then
                return
            end
            if input.KeyCode == Enum.KeyCode.Escape then
                stopListening()
            elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
                el:Set(nil)
            else
                el:Set(input.KeyCode)
            end
            return
        end
        if processed or win._binding or el.Locked then
            return
        end
        if el.Value and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == el.Value then
            fire(opts.Callback, el.Value)
        end
    end)

    win:_registerFlag(opts.Flag, el, "Keybind")
    win:_setFlag(opts.Flag, el.Value)
    return el
end

-- ColorPicker
function Container:ColorPicker(opts)
    opts = norm(opts)
    local win = self.Window
    local el = newCard(self, { Title = opts.Title, Desc = opts.Desc, RightWidth = 48, Locked = opts.Locked })

    local swatch = create(win, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.fromOffset(sz(36, 44), sz(20, 26)),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        BorderSizePixel = 0,
        Parent = el.Header,
    })
    corner(swatch, 4)
    stroke(win, swatch, "Outline")

    -- panel layout (bigger on touch devices)
    local svH = sz(100, 120)
    local hueH = sz(12, 20)
    local hueY = svH + 8
    local hexY = hueY + hueH + 6
    local panelH = hexY + 24 + 2
    local curS = sz(10, 16)

