    })

    -- progress bar
    local track = create(nil, "Frame", {
        Position = UDim2.fromOffset(20, 108),
        Size = UDim2.new(1, -40, 0, 6),
        BackgroundColor3 = theme.Track,
        BorderSizePixel = 0,
        Parent = card,
    })
    corner(track, 3)
    local fill = create(nil, "Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(fill, 3)
    local shimmer = Instance.new("UIGradient")
    shimmer.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, accent),
        ColorSequenceKeypoint.new(0.5, accent:Lerp(Color3.new(1, 1, 1), 0.45)),
        ColorSequenceKeypoint.new(1, accent),
    })
    shimmer.Offset = Vector2.new(-1, 0)
    shimmer.Parent = fill

    -- intro
    tween(card, { GroupTransparency = 0 }, 0.25)
    tween(scale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
    tween(logo, { Rotation = 0 }, 0.5, Enum.EasingStyle.Back)

    -- looping bits (ripple pulse + bar shimmer)
    task.spawn(function()
        while alive and gui.Parent do
            ripple.Size = UDim2.fromOffset(40, 40)
            ripple.BackgroundTransparency = 0.55
            tween(ripple, { Size = UDim2.fromOffset(68, 68), BackgroundTransparency = 1 }, 0.9)
            task.wait(1)
        end
    end)
    task.spawn(function()
        while alive and gui.Parent do
            shimmer.Offset = Vector2.new(-1, 0)
            tween(shimmer, { Offset = Vector2.new(1, 0) }, 0.9, Enum.EasingStyle.Linear)
            task.wait(0.9)
        end
    end)

    local conn = RunService.RenderStepped:Connect(function()
        percent.Text = math.floor(fill.Size.X.Scale * 100 + 0.5) .. "%"
    end)

    task.wait(0.35)

    -- fake steps
    for _, step in ipairs(LOAD_STEPS) do
        status.Text = step[1]
        status.TextTransparency = 1
        tween(status, { TextTransparency = 0 }, 0.15)
        local d = total * step[3]
        tween(fill, { Size = UDim2.fromScale(step[2], 1) }, d, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
        task.wait(d)
    end

    -- done: turn green for a beat, then fade out
    status.TextColor3 = theme.Success
    percent.Text = "100%"
    task.wait(0.3)

    alive = false
    conn:Disconnect()
    tween(card, { GroupTransparency = 1 }, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(scale, { Scale = 1.08 }, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(dim, { BackgroundTransparency = 1 }, 0.3)
    task.wait(0.32)
    gui:Destroy()
end

---------------------------------------------------------------- SAR:CreateWindow

function SAR:CreateWindow(opts)
    opts = opts or {}

    local self = setmetatable({}, Window)
    self.Title = opts.Title or "SAR UI"
    self.ThemeName = type(opts.Theme) == "string" and opts.Theme or "Custom"
    local baseTheme = type(opts.Theme) == "table" and opts.Theme or SAR.Themes[opts.Theme or "Dark"] or Dark
    self.Theme = derive(Dark, baseTheme)
    if self.ThemeName == "Custom" and type(opts.Theme) ~= "table" then
        self.ThemeName = "Dark"
    end
    self.Flags = {}
    self.Tabs = {}
    self.Visible = true
    self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
    self.FolderName = opts.Folder or "SAR_UI"
    self._flags = {}
    self._themed = setmetatable({}, { __mode = "k" })
    self._hooks = setmetatable({}, { __mode = "k" })
    self._conns = {}
    self._notifOrder = 0
    self._fadeFrames = {}
    self._floating = opts.FloatingButton ~= false
    self._onDestroy = opts.OnDestroy

    -- responsive layout state
    self._profileWanted = opts.ShowProfile ~= false
    self._forceCompact = opts.Compact -- nil = automatic, true / false = forced
    self._breakpoint = tonumber(opts.CompactBreakpoint) or 680
    self._resizable = opts.Resizable ~= false
    self._autoSize = opts.Size == nil
    self._drawer = nil

    local LW = opts.LeftWidth or 168
    local RW = opts.RightWidth or 168
    self._LW, self._RW = LW, RW

    local guiName = "SAR_UI"
    removeOld(guiName)

    -- loading screen (visual only), skip with LoadingScreen = false
    if opts.LoadingScreen ~= false then
        local ok = pcall(playLoader, opts, self.Theme)
        if not ok then
            removeOld("SAR_UI_Loader") -- never let the loader block the real window
        end
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = guiName
    mountGui(gui)
    self.Gui = gui

    local size = opts.Size or defaultWindowSize(viewportSize(gui))

    -- Layered soft shadow. Stacked translucent rounded rectangles fade out away from the
    -- window (no image assets needed): a few faint accent layers for a colored halo at the
    -- back, then a stack of black layers for depth. Offset downwards so it looks lifted.
    -- Theme / accent changes recolor the accent layers.
    self._shadowFrames = {}
    local function addShadow(spec, accentLayer)
        local props = {
            Name = accentLayer and "AccentGlow" or "Shadow",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(size.X.Scale, size.X.Offset + spec.Expand, size.Y.Scale, size.Y.Offset + spec.Expand),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Parent = gui,
        }
        local shadow
        if accentLayer then
            shadow = create(self, "Frame", props, { BackgroundColor3 = "Accent" })
        else
            props.BackgroundColor3 = Color3.new(0, 0, 0)
            shadow = create(self, "Frame", props)
        end
        corner(shadow, 6 + math.floor(spec.Expand / 2))
        table.insert(self._shadowFrames, {
            Frame = shadow,
            Expand = spec.Expand,
            OffsetY = spec.OffsetY,
            Transparency = spec.Transparency,
        })
    end

    for i = 1, 3 do
        addShadow({ Expand = 14 + i * 26, OffsetY = 2, Transparency = 0.972 }, true)
    end
    local DARK_LAYERS = 12
    for i = 1, DARK_LAYERS do
        local t = i / DARK_LAYERS
        addShadow({
            Expand = 8 + math.floor(t * 84),
            OffsetY = 3 + math.floor(t * 9),
            Transparency = 0.965,
        }, false)
    end

    local main = create(self, "CanvasGroup", {
        Name = "Main",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = size,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = gui,
    }, { BackgroundColor3 = "Background" })
    corner(main, 6)
    stroke(self, main, "Outline")
    self.Main = main
    table.insert(self._fadeFrames, main)

    self:_connect(RunService.RenderStepped, function()
        if self._destroyed or not main.Parent or not gui.Parent then
            return
        end
        local guiPosition = gui.AbsolutePosition
        local mainPosition = main.AbsolutePosition
        local mainSize = main.AbsoluteSize
        local centerX = mainPosition.X - guiPosition.X + mainSize.X / 2
        local centerY = mainPosition.Y - guiPosition.Y + mainSize.Y / 2
        for _, spec in ipairs(self._shadowFrames) do
            local shadow = spec.Frame
            if shadow.Parent then
                shadow.Position = UDim2.fromOffset(centerX, centerY + spec.OffsetY)
                shadow.Size = UDim2.fromOffset(
                    mainSize.X + spec.Expand,
                    mainSize.Y + spec.Expand
                )
            end
        end
    end)

    local scale = Instance.new("UIScale")
    scale.Parent = main
    self._scale = scale

    -- top bar
    local topbar = create(self, "Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 42),
        BorderSizePixel = 0,
        Parent = main,
    }, { BackgroundColor3 = "Topbar" })
    table.insert(self._fadeFrames, topbar)
    create(self, "Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 1),
        BorderSizePixel = 0,
        Parent = topbar,
    }, { BackgroundColor3 = "Outline" })

    local leftGroup = create(self, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Parent = topbar,
    })
    list(leftGroup, 8, Enum.FillDirection.Horizontal, nil, Enum.VerticalAlignment.Center)
    pad(leftGroup, 12, 0, 0, 0)

    local logo
    if opts.Icon and opts.Icon ~= "" then
        logo = makeIcon(self, { Size = UDim2.fromOffset(22, 22), LayoutOrder = 1, Parent = leftGroup }, opts.Icon)
        setIconColor(logo, self.Theme.Accent)
        self:_hook(logo, function()
            setIconColor(logo, self.Theme.Accent)
        end)
    else
        logo = create(self, "Frame", {
            Size = UDim2.fromOffset(22, 22),
            BorderSizePixel = 0,
            LayoutOrder = 1,
            Parent = leftGroup,
        }, { BackgroundColor3 = "Accent" })
        corner(logo, 4)
        tornadoIcon(self, logo, 16, "AccentText")
    end

    self._titleLabel = textLabel(self, {
        Text = self.Title,
        Font = FONT_BOLD,
        TextSize = 16,
        Size = UDim2.new(0, 0, 0, 18),
        AutomaticSize = Enum.AutomaticSize.X,
        LayoutOrder = 2,
        Parent = leftGroup,
    }, "Text")

    local subtitle = opts.Subtitle
    if subtitle == nil then
        subtitle = "v" .. SAR.Version
    end
    if subtitle ~= "" then
        local pill = create(self, "Frame", {
            Size = UDim2.new(0, 0, 0, 18),
            AutomaticSize = Enum.AutomaticSize.X,
            BorderSizePixel = 0,
            LayoutOrder = 3,
            Parent = leftGroup,
        }, { BackgroundColor3 = "Element" })
        corner(pill, 4)
        pad(pill, 7, 0, 7, 0)
        textLabel(self, {
            Text = subtitle,
            TextSize = 12,
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Parent = pill,
        }, "SubText")
        self._subtitlePill = pill
    end

    local rightGroup = create(self, "Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Parent = topbar,
    })
    list(rightGroup, 4, Enum.FillDirection.Horizontal, nil, Enum.VerticalAlignment.Center)
    pad(rightGroup, 0, 0, 10, 0)

    -- top bar buttons are drawn from bars, no glyphs
    -- min / close live on the right, menu (tabs) + quick (right rail) only show in the compact layout
    local btnSize = sz(28, 34)
    local function topButton(kind, order, hoverKey, parent)
        local b = create(self, "TextButton", {
            Text = "",
            AutoButtonColor = false,
            Size = UDim2.fromOffset(btnSize, btnSize),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            LayoutOrder = order,
            Parent = parent,
        }, { BackgroundColor3 = hoverKey })
        corner(b, 4)
        local c = btnSize / 2
        local bars = {}
        if kind == "min" then
            table.insert(bars, bar(self, b, 10, 2, c, c, 0, "SubText"))
        elseif kind == "menu" then
            for _, dy in ipairs({ -5, 0, 5 }) do
                table.insert(bars, bar(self, b, 12, 2, c, c + dy, 0, "SubText"))
            end
        elseif kind == "quick" then
            for _, d in ipairs({ { -4, -4 }, { 4, -4 }, { -4, 4 }, { 4, 4 } }) do
                table.insert(bars, bar(self, b, 6, 6, c + d[1], c + d[2], 0, "SubText"))
            end
        else
            table.insert(bars, bar(self, b, 12, 2, c, c, 45, "SubText"))
            table.insert(bars, bar(self, b, 12, 2, c, c, -45, "SubText"))
        end
        if not MOBILE then
            b.MouseEnter:Connect(function()
                tween(b, { BackgroundTransparency = 0 }, 0.1)
                if hoverKey == "Danger" then
                    for _, f in ipairs(bars) do
                        tween(f, { BackgroundColor3 = Color3.new(1, 1, 1) }, 0.1)
                    end
                end
            end)
            b.MouseLeave:Connect(function()
                tween(b, { BackgroundTransparency = 1 }, 0.1)
                for _, f in ipairs(bars) do
                    tween(f, { BackgroundColor3 = self.Theme.SubText }, 0.1)
                end
            end)
        end
        return b
    end
    local quickBtn = topButton("quick", 0, "Element", rightGroup)
    local minBtn = topButton("min", 1, "Element", rightGroup)
    local closeBtn = topButton("close", 2, "Danger", rightGroup)
    quickBtn.Visible = false
    self._quickBtn = quickBtn

    -- drag by the top bar. the window glides to the cursor instead of snapping
    -- keeps at least 100px of the window on screen and the top bar reachable
    local function clampOnScreen(pos)
        local vs = gui.AbsoluteSize
        local sz2 = main.AbsoluteSize
        local cx = pos.X.Scale * vs.X + pos.X.Offset
        local cy = pos.Y.Scale * vs.Y + pos.Y.Offset
        cx = math.clamp(cx, 100 - sz2.X / 2, vs.X - 100 + sz2.X / 2)
        cy = math.clamp(cy, sz2.Y / 2, vs.Y - 44 + sz2.Y / 2)
        return UDim2.new(pos.X.Scale, cx - pos.X.Scale * vs.X, pos.Y.Scale, cy - pos.Y.Scale * vs.Y)
    end

    local dragMouse, dragStart, dragTarget
    local windowDragging = bindDrag(self, topbar, function(pos)
        local d = pos - dragMouse
        dragTarget = clampOnScreen(UDim2.new(
            dragStart.X.Scale, dragStart.X.Offset + d.X,
            dragStart.Y.Scale, dragStart.Y.Offset + d.Y
        ))
    end, function(pos)
        dragMouse = pos
        dragStart = main.Position
        dragTarget = main.Position
    end)
    self:_connect(RunService.RenderStepped, function(dt)
        if not dragTarget then
            return
        end
        local cur = main.Position
        local alpha = 1 - math.exp(-dt * 14)
        main.Position = cur:Lerp(dragTarget, alpha)
        if not windowDragging() then
            local dx = math.abs(cur.X.Offset - dragTarget.X.Offset)
            local dy = math.abs(cur.Y.Offset - dragTarget.Y.Offset)
            if dx < 0.4 and dy < 0.4 then
                main.Position = dragTarget
                dragTarget = nil
            end
        end
    end)

    -- body
    local body = create(self, "Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 42),
        Size = UDim2.new(1, 0, 1, -42),
        Parent = main,
    })

    -- left rail gets a search box on top (pushes the title + tab list down)
    local function buildRail(side, width, titleText)
        local isLeft = side == "Left"
        local titleY = isLeft and 46 or 12
        local scrollY = isLeft and 68 or 34

        local rail = create(self, "Frame", {
            Name = side .. "Rail",
            Size = UDim2.new(0, width, 1, 0),
            BorderSizePixel = 0,
            Parent = body,
        }, { BackgroundColor3 = "Sidebar" })
        table.insert(self._fadeFrames, rail)
        local line = create(self, "Frame", {
            Size = UDim2.new(0, 1, 1, 0),
            BorderSizePixel = 0,
            Parent = rail,
        }, { BackgroundColor3 = "Outline" })
        if side == "Right" then
            rail.AnchorPoint = Vector2.new(1, 0)
            rail.Position = UDim2.new(1, 0, 0, 0)
        else
            line.AnchorPoint = Vector2.new(1, 0)
            line.Position = UDim2.new(1, 0, 0, 0)
        end

        if isLeft then
            local field = create(self, "Frame", {
                Name = "Search",
                Size = UDim2.new(1, -16, 0, sz(28, 34)),
                Position = UDim2.fromOffset(8, 10),
                BorderSizePixel = 0,
                Parent = rail,
            }, { BackgroundColor3 = "Field" })
            corner(field, 5)
            stroke(self, field, "Outline")

            -- magnifier drawn from a ring + a bar
            local icon = create(self, "Frame", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 9, 0.5, 0),
                Size = UDim2.fromOffset(14, 14),
                Parent = field,
            })
            local ring = create(self, "Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(0, 0),
                Size = UDim2.fromOffset(9, 9),
                BorderSizePixel = 0,
                Parent = icon,
            })
            corner(ring, 5)
            stroke(self, ring, "SubText", 1.5)
            bar(self, icon, 5, 2, 11, 11, 45, "SubText")

            local box = create(self, "TextBox", {
                Text = "",
                PlaceholderText = "Search...",
                ClearTextOnFocus = false,
                Font = FONT_REG,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ClipsDescendants = true,
                Size = UDim2.new(1, -36, 1, 0),
                Position = UDim2.new(0, 28, 0, 0),
                Parent = field,
            }, { TextColor3 = "Text", PlaceholderColor3 = "SubText" })
            box:GetPropertyChangedSignal("Text"):Connect(function()
                self:Search(box.Text)
            end)
            self._searchBox = box
        end

        local titleLabel = textLabel(self, {
            Text = titleText,
            Font = FONT_BOLD,
            TextSize = 13,
            Size = UDim2.new(1, -28, 0, 16),
            Position = UDim2.new(0, 14, 0, titleY),
            Parent = rail,
        }, "SubText")
        local scroll = create(self, "ScrollingFrame", {
            Name = "Scroll",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, scrollY),
            Size = UDim2.new(1, 0, 1, -scrollY),
            ScrollBarThickness = 2,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Parent = rail,
        }, { ScrollBarImageColor3 = "Accent" })
        pad(scroll, 8, 4, 8, 24)
        list(scroll, 6)
        local railUI = { title = titleLabel, scroll = scroll, y = scrollY }
        self._railUI = self._railUI or {}
        self._railUI[side] = railUI

        if isLeft then
            self._noResults = textLabel(self, {
                Name = "NoResults",
                Text = "No results",
                Font = FONT_REG,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Center,
                Size = UDim2.new(1, -16, 0, 20),
                Position = UDim2.new(0, 8, 0, scrollY + 8),
                Visible = false,
                Parent = rail,
            }, "SubText")
            railUI.noResults = self._noResults
        end

        -- soft edge shadow next to the rail, only visible while it's a drawer (compact layout)
        local shade = create(self, "Frame", {
            Name = "DrawerShade",
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel = 0,
            Size = UDim2.new(0, 16, 1, 0),
            Visible = false,
            ZIndex = 2,
            Parent = rail,
        })
        local shadeGrad = Instance.new("UIGradient")
        shadeGrad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.55),
            NumberSequenceKeypoint.new(1, 1),
        })
        if isLeft then
            shade.Position = UDim2.new(1, 0, 0, 0)
        else
            shade.AnchorPoint = Vector2.new(1, 0)
            shade.Position = UDim2.new(0, 0, 0, 0)
            shadeGrad.Rotation = 180
        end
        shadeGrad.Parent = shade
        self._shades = self._shades or {}
        table.insert(self._shades, shade)

        return rail, scroll
    end

    local leftRail, leftScroll = buildRail("Left", LW, opts.LeftTitle or "Tabs")
    local rightRail, rightScroll = buildRail("Right", RW, opts.RightTitle or "Quick")
    self._leftScroll = leftScroll
    self._leftRail = leftRail
    self._rightRail = rightRail
    self.Left = newContainer(self, leftScroll, Container)
    self.Right = newContainer(self, rightScroll, Container)

    -- middle: channel bar, pages, profile, footer
    local mid = create(self, "Frame", {
        Name = "Middle",
        Position = UDim2.new(0, LW, 0, 0),
        Size = UDim2.new(1, -(LW + RW), 1, 0),
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = body,
    }, { BackgroundColor3 = "Panel" })
    table.insert(self._fadeFrames, mid)
    self._mid = mid

    -- dark layer behind the drawers, tap it to close them (compact layout)
    local scrim = create(self, "TextButton", {
        Name = "Scrim",
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 5,
        Parent = body,
    })
    scrim.MouseButton1Click:Connect(function()
        self:_closeDrawers()
    end)
    self._scrim = scrim

    local chBar = create(self, "Frame", {
        Name = "ChannelBar",
        Size = UDim2.new(1, 0, 0, 40),
        BorderSizePixel = 0,
        Parent = mid,
    }, { BackgroundColor3 = "Panel" })
    table.insert(self._fadeFrames, chBar)
    create(self, "Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 1),
        BorderSizePixel = 0,
        Parent = chBar,
    }, { BackgroundColor3 = "Outline" })
    self._chBar = chBar

    local pages = create(self, "Frame", {
        Name = "Pages",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 41),
        Size = UDim2.new(1, 0, 1, -(41 + PROFILE_H)),
        ClipsDescendants = true,
        Parent = mid,
    })
    self._pages = pages

    -- roblox profile card (name, username, current game, fps/ping)
    local profile = create(self, "Frame", {
        Name = "Profile",
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -(FOOTER_H + 2)),
        Size = UDim2.new(1, -28, 0, 68),
        BorderSizePixel = 0,
        Parent = mid,
    }, { BackgroundColor3 = "Element" })
    local pc = Instance.new("UISizeConstraint")
    pc.MaxSize = Vector2.new(380, 68)
    pc.Parent = profile
    corner(profile, 6)
    stroke(self, profile, "Outline")

    local avatar = create(self, "ImageLabel", {
        Size = UDim2.fromOffset(38, 38),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 8, 0.5, 0),
        BorderSizePixel = 0,
        Image = "",
        Parent = profile,
    }, { BackgroundColor3 = "Track" })
    corner(avatar, 5)

    local player = LocalPlayer
    local nameLabel = textLabel(self, {
        Text = player and player.DisplayName or "Player",
        Font = FONT_BOLD,
        TextSize = 15,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -140, 0, 18),
        Position = UDim2.new(0, 56, 0, 9),
        Parent = profile,
    }, "Text")
    local userLabel = textLabel(self, {
        Text = "@" .. (player and player.Name or "player"),
        Font = FONT_REG,
        TextSize = 13,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -140, 0, 14),
        Position = UDim2.new(0, 56, 0, 27),
        Parent = profile,
    }, "SubText")
    local gameLabel = textLabel(self, {
        Text = "Playing: " .. game.Name,
        Font = FONT_MED,
        TextSize = 12,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -140, 0, 14),
        Position = UDim2.new(0, 56, 0, 44),
        Parent = profile,
    }, "Accent")
    local statsLabel = textLabel(self, {
        Text = "-- fps\n-- ms",
        Font = FONT_MED,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Size = UDim2.fromOffset(66, 34),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Visible = opts.ShowStats ~= false,
        Parent = profile,
    }, "SubText")

    self._profile = profile
    self._profileAvatar = avatar
    self._profileName = nameLabel
    self._profileUser = userLabel
    self._profileGame = gameLabel

    -- real game name from the marketplace (falls back to game.Name above)
    task.spawn(function()
        local ok, info = pcall(function()
            return MarketplaceService:GetProductInfo(game.PlaceId)
        end)
        if ok and info and info.Name and not self._destroyed then
            gameLabel.Text = "Playing: " .. info.Name
        end
    end)

    -- fixed footer text under the profile. plain TextLabel, no API touches it
    self._footer = textLabel(self, {
        Name = "Footer",
        Text = "SAR UI",
        Font = FONT_BOLD,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.new(1, 0, 0, 16),
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -5),
        Parent = mid,
    }, "SubText")

    self:SetProfile({ UserId = player and player.UserId or 1 })

    local frames, last = 0, os.clock()
    self:_connect(RunService.Heartbeat, function()
        frames += 1
    end)
    task.spawn(function()
        while not self._destroyed do
            task.wait(0.5)
            if self._destroyed then
                break
            end
            local now = os.clock()
            local fps = math.floor(frames / math.max(now - last, 0.001) + 0.5)
            frames, last = 0, now
            local ping = 0
            pcall(function()
                ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
            end)
            statsLabel.Text = fps .. " fps\n" .. ping .. " ms"
        end
    end)

    -- resize grip, two little diagonal lines (bigger hit area on touch devices)
    local gripSize = sz(16, 26)
    local grip = create(self, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -2, 1, -2),
        Size = UDim2.fromOffset(gripSize, gripSize),
        ZIndex = 5,
        Parent = main,
    })
    local gripIcon = create(self, "Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, 0, 1, 0),
        Size = UDim2.fromOffset(16, 16),
        ZIndex = 5,
        Parent = grip,
    })
    bar(self, gripIcon, 5, 1, 11.5, 11.5, -45, "SubText").ZIndex = 5
    bar(self, gripIcon, 10, 1, 8.5, 8.5, -45, "SubText").ZIndex = 5
    self._grip = grip
    if self._resizable then
        local startMouse, startSize, startPos
        bindDrag(self, grip, function(pos)
            local d = pos - startMouse
            local w = math.max(startSize.X + d.X, 640)
            local h = math.max(startSize.Y + d.Y, 420)
            main.Size = UDim2.fromOffset(w, h)
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + (w - startSize.X) / 2,
                startPos.Y.Scale, startPos.Y.Offset + (h - startSize.Y) / 2
            )
            self:_layout()
        end, function(pos)
            dragTarget = nil
            self._autoSize = false
            startMouse = pos
            startSize = main.AbsoluteSize
            startPos = main.Position
        end)
    else
        grip.Visible = false
    end

    -- notifications (300 wide max, shrinks on narrow screens)
    local notif = create(self, "Frame", {
        Name = "Notifications",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.new(1, -32, 1, -32),
        Parent = gui,
    })
    sizeMax(notif, 300, math.huge)
    list(notif, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
    self._notifHolder = notif

    -- floating open button (shows when the window is hidden)
    local obs = sz(42, 50)
    local openBtn = create(self, "TextButton", {
        Name = "OpenButton",
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.fromOffset(obs, obs),
        Position = UDim2.new(0, 20, 0.5, -obs / 2),
        BorderSizePixel = 0,
        Visible = false,
        Parent = gui,
    }, { BackgroundColor3 = "Accent" })
    corner(openBtn, 6)
    tornadoIcon(self, openBtn, 24, "AccentText")
    stroke(self, openBtn, "Outline")
    self._openButton = openBtn

    local btnStartMouse, btnStartPos, moved = nil, nil, false
    bindDrag(self, openBtn, function(pos)
        local d = pos - btnStartMouse
        if d.Magnitude > 5 then
            moved = true
        end
        local vs = gui.AbsoluteSize
        local px = math.clamp(btnStartPos.X.Scale * vs.X + btnStartPos.X.Offset + d.X, 0, vs.X - obs)
        local py = math.clamp(btnStartPos.Y.Scale * vs.Y + btnStartPos.Y.Offset + d.Y, 0, vs.Y - obs)
        openBtn.Position = UDim2.fromOffset(px, py)
    end, function(pos)
        btnStartMouse = pos
        btnStartPos = openBtn.Position
        moved = false
    end)
    openBtn.MouseButton1Click:Connect(function()
        if moved then
            moved = false
            return
        end
        self:Toggle(true)
    end)

    minBtn.MouseButton1Click:Connect(function()
        self:Toggle(false)
        if not self._floating then
            self:Notify({
                Title = self.Title .. " hidden",
                Content = "Press " .. self.ToggleKey.Name .. " to open it again.",
                Duration = 3,
            })
        end
    end)
    closeBtn.MouseButton1Click:Connect(function()
        if opts.CloseConfirm == false then
            self:Destroy()
            return
        end
        self:Dialog({
            Title = "Close " .. self.Title,
            Content = "Close this window?",
            Buttons = {
                { Title = "Cancel" },
                { Title = "Close", Variant = "Danger", Callback = function() self:Destroy() end },
            },
        })
    end)

    -- compact layout: grid button opens the quick buttons drawer (right rail)
    quickBtn.MouseButton1Click:Connect(function()
        self:_toggleDrawer("Right")
    end)

    self:_connect(UserInputService.InputBegan, function(input, processed)
        if processed then
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == self.ToggleKey then
            self:Toggle()
        end
    end)

    -- screen size changed (rotation, window resize): refit the window and re-pick the layout
    self:_connect(gui:GetPropertyChangedSignal("AbsoluteSize"), function()
        if self._destroyed then
            return
        end
        if self._autoSize then
            dragTarget = nil
            main.Size = defaultWindowSize(viewportSize(gui))
            main.Position = UDim2.fromScale(0.5, 0.5)
        else
            main.Position = clampOnScreen(main.Position)
        end
        self:_layout(true)
    end)

    -- pick desktop / compact layout for the starting size
    self:_layout(true)

    table.insert(SAR.Windows, self)

    -- play the open animation when the window is created
    self.Visible = false
    main.Visible = false
    self:Toggle(true)
    return self
end

---------------------------------------------------------------- library helpers

function SAR:AddTheme(name, data)
    SAR.Themes[name] = derive(Dark, data)
end

function SAR:Notify(opts)
    local w = SAR.Windows[#SAR.Windows]
    if w then
        return w:Notify(opts)
    end
end

function SAR:DestroyAll()
    for i = #SAR.Windows, 1, -1 do
        SAR.Windows[i]:Destroy()
    end
end

return SAR
