        AutoButtonColor = false,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, sz(28, 32)),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = #self.Channels + 1,
        Parent = self._bar,
    }, { BackgroundColor3 = "Element" })
    corner(btn, 4)
    pad(btn, 10, 0, 10, 0)
    local lbl = textLabel(win, {
        Text = "# " .. title,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Parent = btn,
    })
    local underline = create(win, "Frame", {
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, 0),
        Size = UDim2.new(1, -16, 0, 2),
        BorderSizePixel = 0,
        Visible = false,
        Parent = btn,
    }, { BackgroundColor3 = "Accent" })

    local page = create(win, "ScrollingFrame", {
        Name = "Page_" .. title,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ScrollBarThickness = sz(3, 4),
        CanvasSize = UDim2.new(),
