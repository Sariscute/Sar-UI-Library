---------------------------------------------------------------- helpers

local function norm(o)
    if type(o) == "string" then
        return { Title = o }
    end
    return o or {}
end

local function tween(obj, props, time, style, dir)
    local ok, tw = pcall(function()
        local t = TweenService:Create(
            obj,
            TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
            props
        )
        t:Play()
        return t
    end)
    return ok and tw or nil
end

-- runs a user callback on its own thread, errors are swallowed on purpose
local function fire(callback, ...)
    if type(callback) ~= "function" then
        return
    end
    local args = table.pack(...)
    task.spawn(function()
        pcall(callback, table.unpack(args, 1, args.n))
    end)
end

local function fsAvailable()
    return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function encodeValue(v)
    local tv = typeof(v)
    if tv == "Color3" then
        return { __t = "Color3", r = v.R, g = v.G, b = v.B }
    elseif tv == "EnumItem" then
        return { __t = "KeyCode", n = v.Name }
    end
    return v
end

local function decodeValue(v)
    if type(v) == "table" and v.__t == "Color3" then
        return Color3.new(v.r, v.g, v.b)
    elseif type(v) == "table" and v.__t == "KeyCode" then
        return v.n and Enum.KeyCode[v.n] or nil
    end
    return v
end

