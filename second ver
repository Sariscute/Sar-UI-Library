    local hueCursor = create(win, "Frame", {
        Size = UDim2.fromOffset(4, hueH + 4),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = hueBar,
    })
    corner(hueCursor, 2)
    local hs = Instance.new("UIStroke")
    hs.Color = Color3.new(0, 0, 0)
    hs.Thickness = 1
    hs.Transparency = 0.5
    hs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    hs.Parent = hueCursor

    local hexField = create(win, "Frame", {
        Size = UDim2.new(1, 0, 0, sz(24, 30)),
        Position = UDim2.new(0, 0, 0, hexY),
        BorderSizePixel = 0,
        Parent = panel,
    }, { BackgroundColor3 = "Field" })
    corner(hexField, 4)
    stroke(win, hexField, "Outline")
    local hexBox = create(win, "TextBox", {
        Font = FONT_REG,
        TextSize = 13,
        ClearTextOnFocus = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = hexField,
    }, { TextColor3 = "Text" })

    -- the hex row got taller on touch, keep the panel tall enough for it
    panelH = hexY + sz(24, 30) + 2

    local color = opts.Default or Color3.fromRGB(255, 255, 255)
    local h, s, v = color:ToHSV()
    el.Value = color

    local function render()
        color = Color3.fromHSV(h, s, v)
        el.Value = color
        swatch.BackgroundColor3 = color
        svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.fromScale(s, 1 - v)
        hueCursor.Position = UDim2.fromScale(h, 0.5)
        hexBox.Text = "#" .. color:ToHex()
    end
    render()

    local function commit(silent)
        render()
        win:_setFlag(opts.Flag, color)
        if not silent then
            fire(opts.Callback, color)
        end
    end

    function el:Set(c, silent)
        if typeof(c) ~= "Color3" then
            return
        end
        h, s, v = c:ToHSV()
        commit(silent)
    end
    function el:Get()
        return self.Value
    end

    bindDrag(win, svHit, function(pos)
        if el.Locked then
            return false
        end
        s = math.clamp((pos.X - svBox.AbsolutePosition.X) / math.max(svBox.AbsoluteSize.X, 1), 0, 1)
        v = 1 - math.clamp((pos.Y - svBox.AbsolutePosition.Y) / math.max(svBox.AbsoluteSize.Y, 1), 0, 1)
        commit()
    end)
    bindDrag(win, hueBar, function(pos)
        if el.Locked then
            return false
        end
        h = math.clamp((pos.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
        commit()
    end)

    hexBox.FocusLost:Connect(function()
        local text = hexBox.Text:gsub("#", "")
        local ok, c = pcall(Color3.fromHex, text)
        if ok and typeof(c) == "Color3" then
            el:Set(c)
        else
            render()
        end
    end)

    local open = false
    local function setOpen(state)
        if state and el.Locked then
            return
        end
        open = state
        if state then
            panel.Visible = true
            panel.Size = UDim2.new(1, 0, 0, 0)
            tween(panel, { Size = UDim2.new(1, 0, 0, panelH) }, 0.18)
        else
            tween(panel, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
            task.delay(0.17, function()
                if not open then
                    panel.Visible = false
                end
            end)
        end
    end
    swatch.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)

    finalize(win, el, opts, color)
    return el
end

-- Section (collapsible group, gives back a container)
function Container:Section(opts)
    opts = norm(opts)
    local win = self.Window

    local wrapper = create(win, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = self:_next(),
        Parent = self.Frame,
    })
    list(wrapper, 8)

    local header = create(win, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, sz(22, 28)),
        LayoutOrder = 1,
        Parent = wrapper,
    })
    local title = textLabel(win, {
        Text = opts.Title or "Section",
        Font = FONT_BOLD,
        TextSize = 13,
        Size = UDim2.new(1, -24, 1, 0),
        Parent = header,
    }, "SubText")
    local arrow = chevron(win, {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Parent = header,
    }, "SubText")

    local body = create(win, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 2,
        Parent = wrapper,
    })
    list(body, 8)

    local sec = newContainer(win, body, Container)
    sec.Header = header
    local opened = opts.Opened ~= false

    function sec:SetOpen(state)
        opened = state and true or false
        body.Visible = opened
        tween(arrow, { Rotation = opened and 0 or -90 }, 0.15)
    end
    function sec:SetTitle(text)
        title.Text = text
    end
    function sec:Destroy()
        wrapper:Destroy()
    end

    sec:SetOpen(opened)
    if opts.Collapsible == false then
        arrow.Visible = false
    else
        header.MouseButton1Click:Connect(function()
            sec:SetOpen(not opened)
        end)
    end
    return sec
end

-- tabs forward these to their default channel
local ELEMENT_NAMES = {
    "Label", "Paragraph", "Button", "Toggle", "Slider", "Dropdown",
    "Input", "Keybind", "ColorPicker", "Divider", "Section",
}

---------------------------------------------------------------- channel

function Channel:Select()
    self.Tab:SelectChannel(self)
end

function Channel:SetTitle(text)
    self.Title = text
    self._label.Text = "# " .. text
end

function Channel:Destroy()
    local tab = self.Tab
    local idx = table.find(tab.Channels, self)
    if idx then
        table.remove(tab.Channels, idx)
    end
    self._button:Destroy()
    self._page:Destroy()
    if tab.SelectedChannel == self then
        tab.SelectedChannel = nil
        if tab.Channels[1] then
            tab:SelectChannel(tab.Channels[1])
        end
    end
    if tab._defaultChannel == self then
        tab._defaultChannel = nil
    end
end

---------------------------------------------------------------- tab

function Tab:Channel(opts)
    opts = norm(opts)
    local win = self.Window
    local title = opts.Title or "general"

    local btn = create(win, "TextButton", {
        Name = "Channel_" .. title,
