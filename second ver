-- lucide "tornado" icon drawn from 5 rounded bars
-- win = nil  -> color is a plain Color3
-- win = self -> color is a theme key like "AccentText"
local TORNADO = { { 3, 21, 4 }, { 6, 18, 8 }, { 9, 19, 12 }, { 10, 16, 16 }, { 9, 11, 20 } }

local function tornadoIcon(win, parent, size, color)
    local s = size / 24
    local box = create(nil, "Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = parent,
    })
    for _, l in ipairs(TORNADO) do
        local props = {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset((l[1] + l[2]) / 2 * s, l[3] * s),
            Size = UDim2.fromOffset((l[2] - l[1] + 2) * s, 2 * s),
            BorderSizePixel = 0,
            Parent = box,
        }
        local b
        if win then
            b = create(win, "Frame", props, { BackgroundColor3 = color })
        else
            props.BackgroundColor3 = color
            b = create(nil, "Frame", props)
        end
        corner(b, s)
    end
    return box
end

