function Window:Notify(opts)
    opts = norm(opts)
    local t = self.Theme
    local colors = { Info = t.Accent, Success = t.Success, Warning = t.Warning, Error = t.Danger }
    local color = colors[opts.Type or "Info"] or t.Accent
    local duration = opts.Duration or 4
    self._notifOrder += 1

    local wrap = create(self, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = self._notifOrder,
        Parent = self._notifHolder,
    })
    local card = create(self, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        Position = UDim2.new(1.2, 0, 0, 0),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = wrap,
    }, { BackgroundColor3 = "Element" })
    corner(card, 5)
    stroke(self, card, "Outline")

    create(self, "Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Parent = card,
    })
    local content = create(self, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = card,
    })
    pad(content, 16, 10, 12, 14)
    list(content, 3)
    textLabel(self, {
        Text = opts.Title or "Notification",
        Font = FONT_BOLD,
        TextWrapped = true,
        Size = UDim2.new(1, 0, 0, 16),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = content,
    }, "Text")
    if opts.Content and opts.Content ~= "" then
        textLabel(self, {
            Text = opts.Content,
            Font = FONT_REG,
            TextSize = 13,
            TextWrapped = true,
            Size = UDim2.new(1, 0, 0, 14),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 2,
            Parent = content,
        }, "SubText")
    end
    local timer = create(self, "Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Parent = card,
    })

    tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.3, Enum.EasingStyle.Quint)
    tween(timer, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)

    local dismissed = false
    local function dismiss()
        if dismissed then
            return
        end
        dismissed = true
        tween(card, { Position = UDim2.new(1.2, 0, 0, 0) }, 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.3, function()
            wrap:Destroy()
        end)
    end
    card.MouseButton1Click:Connect(dismiss)
    task.delay(duration, dismiss)
    return { Dismiss = dismiss }
end

function Window:Dialog(opts)
    opts = norm(opts)
    local t = self.Theme

    local overlay = create(self, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 50,
        Parent = self.Main,
    })
    tween(overlay, { BackgroundTransparency = 0.4 }, 0.2)

    local card = create(self, "Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(0, opts.Width or 340, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        Parent = overlay,
    }, { BackgroundColor3 = "Element" })
    corner(card, 6)
    stroke(self, card, "Outline")
    pad(card, 18, 16, 18, 16)
    list(card, 8)

    textLabel(self, {
        Text = opts.Title or "Dialog",
        Font = FONT_BOLD,
        TextSize = 16,
        TextWrapped = true,
        Size = UDim2.new(1, 0, 0, 20),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = card,
    }, "Text")
    if opts.Content and opts.Content ~= "" then
        textLabel(self, {
            Text = opts.Content,
            Font = FONT_REG,
            TextSize = 14,
            TextWrapped = true,
            Size = UDim2.new(1, 0, 0, 16),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 2,
            Parent = card,
        }, "SubText")
    end

    local row = create(self, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 34),
        LayoutOrder = 3,
        Parent = card,
    })
    list(row, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)

    local closed = false
    local function close()
        if closed then
            return
        end
        closed = true
        card.Visible = false
        tween(overlay, { BackgroundTransparency = 1 }, 0.15)
        task.delay(0.17, function()
            overlay:Destroy()
        end)
    end

    local buttons = opts.Buttons or { { Title = "OK", Variant = "Primary" } }
    for i, b in ipairs(buttons) do
        local variant = b.Variant or (i == #buttons and "Primary" or "Default")
        local bg, fg = t.Field, t.Text
        if variant == "Primary" then
            bg, fg = t.Accent, t.AccentText
        elseif variant == "Danger" then
            bg, fg = t.Danger, Color3.new(1, 1, 1)
        end
        local btn = create(self, "TextButton", {
            Text = b.Title or "OK",
            Font = FONT_MED,
            TextSize = 14,
            TextColor3 = fg,
            BackgroundColor3 = bg,
            AutoButtonColor = true,
            AutomaticSize = Enum.AutomaticSize.X,
            Size = UDim2.new(0, 0, 0, 32),
            BorderSizePixel = 0,
            LayoutOrder = i,
            Parent = row,
        })
        corner(btn, 4)
        pad(btn, 16, 0, 16, 0)
        btn.MouseButton1Click:Connect(function()
            close()
            fire(b.Callback)
        end)
    end

    return { Close = close }
end

---------------------------------------------------------------- window api

function Window:Toggle(state)
    if state == nil then
        state = not self.Visible
    end
    self.Visible = state
    self.Main.Visible = state
    if self._openButton then
        self._openButton.Visible = (not state) and self._floating
    end
end

function Window:SetTitle(text)
    self.Title = text
    self._titleLabel.Text = text
end

function Window:SetTheme(theme)
    local data
    if type(theme) == "string" then
        data = SAR.Themes[theme]
        if not data then
            return
        end
        self.ThemeName = theme
    elseif type(theme) == "table" then
        data = theme
    else
        return
    end
    self.Theme = derive(Dark, data)
    self:_applyTheme()
end

function Window:SetAccent(color)
    if typeof(color) ~= "Color3" then
        return
    end
    self.Theme.Accent = color
    self:_applyTheme()
end

function Window:SetTransparency(n)
    n = math.clamp(tonumber(n) or 0, 0, 0.9)
    for _, f in ipairs(self._fadeFrames) do
        f.BackgroundTransparency = n
    end
end

function Window:SetProfileVisible(state)
    self._profile.Visible = state
    self._pages.Size = UDim2.new(1, 0, 1, -(41 + (state and PROFILE_H or FOOTER_H)))
end

function Window:SetProfile(info)
    info = info or {}
    if info.DisplayName then
        self._profileName.Text = info.DisplayName
    end
    if info.Username then
        self._profileUser.Text = "@" .. info.Username
    end
    if info.UserId then
        task.spawn(function()
            local ok, img = pcall(function()
                return Players:GetUserThumbnailAsync(info.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
            end)
            if ok and img then
                self._profileAvatar.Image = img
            end
        end)
    end
end

function Window:GetFlag(name)
    return self.Flags[name]
end

function Window:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    for _, c in ipairs(self._conns) do
        c:Disconnect()
    end
    self._conns = {}
    local idx = table.find(SAR.Windows, self)
    if idx then
        table.remove(SAR.Windows, idx)
    end
    self.Gui:Destroy()
    fire(self._onDestroy)
end

---------------------------------------------------------------- configs

function Window:_cfgFolder()
    return self.FolderName .. "/configs"
end

function Window:_cfgPath(name)
    return self:_cfgFolder() .. "/" .. name .. ".json"
end

function Window:ListConfigs()
    local out = {}
    if fsAvailable() and typeof(listfiles) == "function" then
        local ok, files = pcall(listfiles, self:_cfgFolder())
        if ok and type(files) == "table" then
            for _, p in ipairs(files) do
                local n = tostring(p):match("([^/\\]+)%.json$")
                if n then
                    table.insert(out, n)
                end
            end
        end
    end
    table.sort(out)
    return out
end

function Window:SaveConfig(name)
    name = (name and name ~= "") and name or "default"
    if not fsAvailable() then
        return false, "File functions are not available here"
    end
    local data = {}
    for flag, entry in pairs(self._flags) do
        local ok, v = pcall(function()
            return entry.el:Get()
        end)
        if ok then
            if v == nil and entry.kind == "Keybind" then
                data[flag] = { __t = "KeyCode" }
            elseif v ~= nil then
                data[flag] = encodeValue(v)
            end
        end
    end
    if typeof(makefolder) == "function" then
        pcall(makefolder, self.FolderName)
        pcall(makefolder, self:_cfgFolder())
    end
    local ok, err = pcall(writefile, self:_cfgPath(name), HttpService:JSONEncode(data))
    return ok, err
end

function Window:LoadConfig(name)
    name = (name and name ~= "") and name or "default"
    if not fsAvailable() then
        return false, "File functions are not available here"
    end
    local path = self:_cfgPath(name)
    if not isfile(path) then
        return false, "Config not found"
    end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not ok or type(data) ~= "table" then
        return false, "Invalid config file"
    end
    for flag, raw in pairs(data) do
        local entry = self._flags[flag]
        if entry then
            pcall(function()
                entry.el:Set(decodeValue(raw))
            end)
        end
    end
    return true
end

function Window:DeleteConfig(name)
    if not fsAvailable() or typeof(delfile) ~= "function" then
        return false, "File functions are not available here"
    end
    local path = self:_cfgPath(name)
    if not isfile(path) then
        return false, "Config not found"
    end
    return pcall(delfile, path)
end

