function Window:CreateSettingsTab(opts)
    opts = opts or {}
    local tab = self:Tab({ Title = opts.Title or "Settings", Icon = opts.Icon })

    local ui = tab:Channel("interface")
    local themeNames = {}
    for name in pairs(SAR.Themes) do
        table.insert(themeNames, name)
    end
    table.sort(themeNames)

    ui:Dropdown({
        Title = "Theme",
        Values = themeNames,
        Default = self.ThemeName,
        CallOnCreate = false,
        Callback = function(v)
            self:SetTheme(v)
        end,
    })
    ui:ColorPicker({
        Title = "Accent color",
        Default = self.Theme.Accent,
        CallOnCreate = false,
        Callback = function(c)
            self:SetAccent(c)
        end,
    })
    ui:Dropdown({
        Title = "Layout",
        Desc = "Auto slims the tabs and tucks the quick rail away on small screens",
        Values = { "Auto", "Compact", "Desktop" },
        Default = self._forceCompact == nil and "Auto" or (self._forceCompact and "Compact" or "Desktop"),
        CallOnCreate = false,
        Callback = function(v)
            self:SetLayout(v)
        end,
    })
    -- no point in a toggle key on devices without a keyboard
    if not MOBILE then
        ui:Keybind({
            Title = "Toggle UI key",
            Default = self.ToggleKey,
            ChangedCallback = function(k)
                if k then
                    self.ToggleKey = k
                end
            end,
        })
    end
    ui:Slider({
        Title = "Window transparency",
        Min = 0,
        Max = 60,
        Default = 0,
        Suffix = "%",
        CallOnCreate = false,
        Callback = function(v)
            self:SetTransparency(v / 100)
        end,
    })
    ui:Toggle({
        Title = "Show profile",
        Desc = "Hidden automatically when the window is small",
        Default = true,
        CallOnCreate = false,
        Callback = function(v)
            self:SetProfileVisible(v)
        end,
    })
    ui:Button({
        Title = "Destroy UI",
        Desc = "Removes the window until you run the script again",
        Callback = function()
            self:Dialog({
                Title = "Destroy UI",
                Content = "This removes the window until you run the script again.",
                Buttons = {
                    { Title = "Cancel" },
                    { Title = "Destroy", Variant = "Danger", Callback = function() self:Destroy() end },
                },
            })
        end,
    })

    local cfg = tab:Channel("configs")
    local nameInput = cfg:Input({ Title = "Config name", Placeholder = "default" })
    local saved = cfg:Dropdown({ Title = "Saved configs", Values = self:ListConfigs() })

    local function pickName()
        if nameInput.Value and nameInput.Value ~= "" then
            return nameInput.Value
        end
        return saved.Value or "default"
    end

    cfg:Button({
        Title = "Save config",
        Desc = "Saves every element that has a Flag",
        Callback = function()
            local ok, err = self:SaveConfig(pickName())
            self:Notify({
                Title = ok and "Config saved" or "Save failed",
                Content = ok and pickName() or tostring(err),
                Type = ok and "Success" or "Error",
            })
            saved:Refresh(self:ListConfigs(), true)
        end,
    })
    cfg:Button({
        Title = "Load config",
        Callback = function()
            local ok, err = self:LoadConfig(pickName())
            self:Notify({
                Title = ok and "Config loaded" or "Load failed",
                Content = ok and pickName() or tostring(err),
                Type = ok and "Success" or "Error",
            })
        end,
    })
    cfg:Button({
        Title = "Delete config",
        Callback = function()
            local ok, err = self:DeleteConfig(pickName())
            self:Notify({
                Title = ok and "Config deleted" or "Delete failed",
                Content = ok and pickName() or tostring(err),
                Type = ok and "Warning" or "Error",
            })
            saved:Refresh(self:ListConfigs())
        end,
    })
    cfg:Button({
        Title = "Refresh list",
        Callback = function()
            saved:Refresh(self:ListConfigs(), true)
        end,
    })
    return tab
end

---------------------------------------------------------------- gui mounting

local function playerGui()
    return LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

local function mountGui(gui)
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 1000

    if typeof(syn) == "table" and syn.protect_gui then
        pcall(syn.protect_gui, gui)
    end

    if typeof(gethui) == "function" then
        local ok, holder = pcall(gethui)
        if ok and typeof(holder) == "Instance" then
            gui.Parent = holder
            return
        end
    end

    local ok = pcall(function()
        gui.Parent = CoreGui
    end)
    if not ok or gui.Parent ~= CoreGui then
        gui.Parent = playerGui() or (LocalPlayer and LocalPlayer:WaitForChild("PlayerGui"))
    end
end

local function removeOld(name)
    local places = { CoreGui, playerGui() }
    if typeof(gethui) == "function" then
        local ok, holder = pcall(gethui)
        if ok then
            table.insert(places, holder)
        end
    end
    for _, place in ipairs(places) do
        pcall(function()
            local old = place:FindFirstChild(name)
            if old then
                old:Destroy()
            end
        end)
    end
end

