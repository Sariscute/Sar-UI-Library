    })
    corner(swatch, 4)
    stroke(win, swatch, "Outline")

    local panel = create(win, "Frame", {
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Size = UDim2.new(1, 0, 0, 0),
        Visible = false,
        LayoutOrder = 2,
        Parent = el.Frame,
    })

    local svBox = create(win, "Frame", {
        Size = UDim2.new(1, 0, 0, 100),
        BorderSizePixel = 0,
        Parent = panel,
    })
    corner(svBox, 4)
    local white = create(win, "Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = svBox,
    })
    corner(white, 4)
    local wg = Instance.new("UIGradient")
    wg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
    wg.Parent = white
    local black = create(win, "Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(0, 0, 0),
        BorderSizePixel = 0,
        Parent = svBox,
    })
    corner(black, 4)
    local bg = Instance.new("UIGradient")
    bg.Rotation = 90
    bg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
    bg.Parent = black
    local svHit = create(win, "TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 3,
        Parent = svBox,
    })
    local svCursor = create(win, "Frame", {
        Size = UDim2.fromOffset(10, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = svBox,
    })
    corner(svCursor, 5)
    local cs = Instance.new("UIStroke")
    cs.Color = Color3.new(1, 1, 1)
    cs.Thickness = 2
    cs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    cs.Parent = svCursor

    local hueBar = create(win, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, 12),
        Position = UDim2.new(0, 0, 0, 108),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = panel,
    })
    corner(hueBar, 3)
    local hg = Instance.new("UIGradient")
    hg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
        ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
        ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
        ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
        ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
        ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
        ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
    })
    hg.Parent = hueBar
    local hueCursor = create(win, "Frame", {
        Size = UDim2.fromOffset(4, 16),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = hueBar,
    })
    corner(hueCursor, 2)
    local hs = Instance.new("UIStroke")
    hs.Color = Color3.new(0, 0, 0)
    hs.Thickness = 1
    hs.Transparency = 0.5
    hs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    hs.Parent = hueCursor

    local hexField = create(win, "Frame", {
        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.new(0, 0, 0, 126),
        BorderSizePixel = 0,
        Parent = panel,
    }, { BackgroundColor3 = "Field" })
    corner(hexField, 4)
    stroke(win, hexField, "Outline")
    local hexBox = create(win, "TextBox", {
        Font = FONT_REG,
        TextSize = 13,
        ClearTextOnFocus = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = hexField,
    }, { TextColor3 = "Text" })

    local color = opts.Default or Color3.fromRGB(255, 255, 255)
    local h, s, v = color:ToHSV()
    el.Value = color

    local function render()
        color = Color3.fromHSV(h, s, v)
        el.Value = color
        swatch.BackgroundColor3 = color
        svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.fromScale(s, 1 - v)
        hueCursor.Position = UDim2.fromScale(h, 0.5)
        hexBox.Text = "#" .. color:ToHex()
    end
    render()

    local function commit(silent)
        render()
        win:_setFlag(opts.Flag, color)
        if not silent then
            fire(opts.Callback, color)
        end
    end

    function el:Set(c, silent)
        if typeof(c) ~= "Color3" then
            return
        end
        h, s, v = c:ToHSV()
        commit(silent)
    end
    function el:Get()
        return self.Value
    end

    bindDrag(win, svHit, function(pos)
        if el.Locked then
            return false
        end
        s = math.clamp((pos.X - svBox.AbsolutePosition.X) / math.max(svBox.AbsoluteSize.X, 1), 0, 1)
        v = 1 - math.clamp((pos.Y - svBox.AbsolutePosition.Y) / math.max(svBox.AbsoluteSize.Y, 1), 0, 1)
        commit()
    end)
    bindDrag(win, hueBar, function(pos)
        if el.Locked then
            return false
        end
        h = math.clamp((pos.X - hueBar.AbsolutePosition.X) / math.max(hueBar.AbsoluteSize.X, 1), 0, 1)
        commit()
    end)

    hexBox.FocusLost:Connect(function()
        local text = hexBox.Text:gsub("#", "")
        local ok, c = pcall(Color3.fromHex, text)
        if ok and typeof(c) == "Color3" then
            el:Set(c)
        else
            render()
        end
    end)

    local open = false
    local function setOpen(state)
        if state and el.Locked then
            return
        end
        open = state
        if state then
            panel.Visible = true
            panel.Size = UDim2.new(1, 0, 0, 0)
            tween(panel, { Size = UDim2.new(1, 0, 0, 150) }, 0.18)
        else
            tween(panel, { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
            task.delay(0.17, function()
                if not open then
                    panel.Visible = false
                end
            end)
        end
    end
    swatch.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)

    finalize(win, el, opts, color)
    return el
end

-- Section (collapsible group, gives back a container)
function Container:Section(opts)
    opts = norm(opts)
    local win = self.Window

    local wrapper = create(win, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = self:_next(),
        Parent = self.Frame,
    })
    list(wrapper, 8)

    local header = create(win, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 22),
        LayoutOrder = 1,
        Parent = wrapper,
    })
    local title = textLabel(win, {
        Text = opts.Title or "Section",
        Font = FONT_BOLD,
        TextSize = 13,
        Size = UDim2.new(1, -24, 1, 0),
        Parent = header,
    }, "SubText")
    local arrow = chevron(win, {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Parent = header,
    }, "SubText")

    local body = create(win, "Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 2,
        Parent = wrapper,
    })
    list(body, 8)

    local sec = newContainer(win, body, Container)
    sec.Header = header
    local opened = opts.Opened ~= false

    function sec:SetOpen(state)
        opened = state and true or false
        body.Visible = opened
        tween(arrow, { Rotation = opened and 0 or -90 }, 0.15)
    end
    function sec:SetTitle(text)
        title.Text = text
    end
    function sec:Destroy()
        wrapper:Destroy()
    end

    sec:SetOpen(opened)
    if opts.Collapsible == false then
        arrow.Visible = false
    else
        header.MouseButton1Click:Connect(function()
            sec:SetOpen(not opened)
        end)
    end
    return sec
end

-- tabs forward these to their default channel
local ELEMENT_NAMES = {
    "Label", "Paragraph", "Button", "Toggle", "Slider", "Dropdown",
    "Input", "Keybind", "ColorPicker", "Divider", "Section",
}

---------------------------------------------------------------- channel

function Channel:Select()
    self.Tab:SelectChannel(self)
end

function Channel:SetTitle(text)
    self.Title = text
    self._label.Text = "# " .. text
end

function Channel:Destroy()
    local tab = self.Tab
    local idx = table.find(tab.Channels, self)
    if idx then
        table.remove(tab.Channels, idx)
    end
    self._button:Destroy()
    self._page:Destroy()
    if tab.SelectedChannel == self then
        tab.SelectedChannel = nil
        if tab.Channels[1] then
            tab:SelectChannel(tab.Channels[1])
        end
    end
    if tab._defaultChannel == self then
        tab._defaultChannel = nil
    end
end

---------------------------------------------------------------- tab

function Tab:Channel(opts)
    opts = norm(opts)
    local win = self.Window
    local title = opts.Title or "general"

    local btn = create(win, "TextButton", {
        Name = "Channel_" .. title,
        Text = "",
        AutoButtonColor = false,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 0, 28),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = #self.Channels + 1,
        Parent = self._bar,
    }, { BackgroundColor3 = "Element" })
    corner(btn, 4)
    pad(btn, 10, 0, 10, 0)
    local lbl = textLabel(win, {
        Text = "# " .. title,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Parent = btn,
    })
    local underline = create(win, "Frame", {
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, 0),
        Size = UDim2.new(1, -16, 0, 2),
        BorderSizePixel = 0,
        Visible = false,
        Parent = btn,
    }, { BackgroundColor3 = "Accent" })

    local page = create(win, "ScrollingFrame", {
        Name = "Page_" .. title,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ScrollBarThickness = 3,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = win._pages,
    }, { ScrollBarImageColor3 = "Accent" })
    pad(page, 14, 12, 14, 12)
    list(page, 8)

    local ch = newContainer(win, page, Channel)
    ch.Tab = self
    ch.Title = title
    ch._button = btn
    ch._label = lbl
    ch._underline = underline
    ch._page = page

    table.insert(self.Channels, ch)

    btn.MouseEnter:Connect(function()
        if self.SelectedChannel ~= ch then
            tween(btn, { BackgroundTransparency = 0.6 }, 0.1)
        end
    end)
    btn.MouseLeave:Connect(function()
        if self.SelectedChannel ~= ch then
            tween(btn, { BackgroundTransparency = 1 }, 0.1)
        end
    end)
    btn.MouseButton1Click:Connect(function()
        self:SelectChannel(ch)
    end)

    if not self.SelectedChannel then
        self:SelectChannel(ch)
    else
        self:_visual()
    end
    return ch
end

function Tab:SelectChannel(ch)
    if type(ch) == "string" then
        for _, c in ipairs(self.Channels) do
            if c.Title == ch then
                ch = c
                break
            end
        end
    end
    if type(ch) ~= "table" then
        return
    end
    if self.SelectedChannel and self.SelectedChannel ~= ch then
        self.SelectedChannel._page.Visible = false
    end
    self.SelectedChannel = ch
    ch._page.Visible = (self.Window.SelectedTab == self)
    self:_visual()
end

function Tab:_visual()
    local win = self.Window
    local t = win.Theme
    local selected = win.SelectedTab == self
    tween(self._button, { BackgroundTransparency = selected and 0 or 1 }, 0.15)
    self._indicator.Visible = selected
    self._label.TextColor3 = selected and t.Text or t.SubText
    setIconColor(self._icon, selected and t.Accent or t.SubText)
    for _, ch in ipairs(self.Channels) do
        local sel = self.SelectedChannel == ch
        tween(ch._button, { BackgroundTransparency = sel and 0 or 1 }, 0.15)
        ch._label.TextColor3 = sel and t.Text or t.SubText
        ch._underline.Visible = sel
    end
end

function Tab:_default()
    if not self._defaultChannel then
        self._defaultChannel = self:Channel({ Title = self.DefaultChannelName })
    end
    return self._defaultChannel
end

for _, name in ipairs(ELEMENT_NAMES) do
    Tab[name] = function(self, ...)
        local ch = self:_default()
        return ch[name](ch, ...)
    end
end

function Tab:Select()
    self.Window:SelectTab(self)
end

function Window:Tab(opts)
    opts = norm(opts)
    local title = opts.Title or "Tab"

    local tab = setmetatable({
        Window = self,
