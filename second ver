        }, { BackgroundColor3 = "Accent" })
        corner(logo, 4)
        textLabel(self, {
            Text = "S",
            Font = FONT_BOLD,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Center,
            Size = UDim2.fromScale(1, 1),
            Parent = logo,
        }, "AccentText")
    end

    self._titleLabel = textLabel(self, {
        Text = self.Title,
        Font = FONT_BOLD,
        TextSize = 16,
        Size = UDim2.new(0, 0, 0, 18),
        AutomaticSize = Enum.AutomaticSize.X,
        LayoutOrder = 2,
        Parent = leftGroup,
    }, "Text")

    local subtitle = opts.Subtitle
    if subtitle == nil then
        subtitle = "v" .. SAR.Version
    end
    if subtitle ~= "" then
        local pill = create(self, "Frame", {
            Size = UDim2.new(0, 0, 0, 18),
            AutomaticSize = Enum.AutomaticSize.X,
            BorderSizePixel = 0,
            LayoutOrder = 3,
            Parent = leftGroup,
        }, { BackgroundColor3 = "Element" })
        corner(pill, 4)
        pad(pill, 7, 0, 7, 0)
        textLabel(self, {
            Text = subtitle,
            TextSize = 12,
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            Parent = pill,
        }, "SubText")
    end

    local rightGroup = create(self, "Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        Parent = topbar,
    })
    list(rightGroup, 4, Enum.FillDirection.Horizontal, nil, Enum.VerticalAlignment.Center)
    pad(rightGroup, 0, 0, 10, 0)

    -- minimize / close buttons are drawn from bars, no glyphs
    local function topButton(kind, order, hoverKey)
        local b = create(self, "TextButton", {
            Text = "",
            AutoButtonColor = false,
            Size = UDim2.fromOffset(28, 28),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            LayoutOrder = order,
            Parent = rightGroup,
        }, { BackgroundColor3 = hoverKey })
        corner(b, 4)
        local bars = {}
        if kind == "min" then
            table.insert(bars, bar(self, b, 10, 2, 14, 14, 0, "SubText"))
        else
            table.insert(bars, bar(self, b, 12, 2, 14, 14, 45, "SubText"))
            table.insert(bars, bar(self, b, 12, 2, 14, 14, -45, "SubText"))
        end
        b.MouseEnter:Connect(function()
            tween(b, { BackgroundTransparency = 0 }, 0.1)
            if hoverKey == "Danger" then
                for _, f in ipairs(bars) do
                    tween(f, { BackgroundColor3 = Color3.new(1, 1, 1) }, 0.1)
                end
            end
        end)
        b.MouseLeave:Connect(function()
            tween(b, { BackgroundTransparency = 1 }, 0.1)
            for _, f in ipairs(bars) do
                tween(f, { BackgroundColor3 = self.Theme.SubText }, 0.1)
            end
        end)
        return b
    end
    local minBtn = topButton("min", 1, "Element")
    local closeBtn = topButton("close", 2, "Danger")

    -- drag by the top bar. the window glides to the cursor instead of snapping
    local dragMouse, dragStart, dragTarget
    local windowDragging = bindDrag(self, topbar, function(pos)
        local d = pos - dragMouse
        dragTarget = UDim2.new(
            dragStart.X.Scale, dragStart.X.Offset + d.X,
            dragStart.Y.Scale, dragStart.Y.Offset + d.Y
        )
    end, function(pos)
        dragMouse = pos
        dragStart = main.Position
        dragTarget = main.Position
    end)
    self:_connect(RunService.RenderStepped, function(dt)
        if not dragTarget then
            return
        end
        local cur = main.Position
        local alpha = 1 - math.exp(-dt * 14)
        main.Position = cur:Lerp(dragTarget, alpha)
        if not windowDragging() then
            local dx = math.abs(cur.X.Offset - dragTarget.X.Offset)
            local dy = math.abs(cur.Y.Offset - dragTarget.Y.Offset)
            if dx < 0.4 and dy < 0.4 then
                main.Position = dragTarget
                dragTarget = nil
            end
        end
    end)

    -- body
    local body = create(self, "Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 42),
        Size = UDim2.new(1, 0, 1, -42),
        Parent = main,
    })

    local function buildRail(side, width, titleText)
        local rail = create(self, "Frame", {
            Name = side .. "Rail",
            Size = UDim2.new(0, width, 1, 0),
            BorderSizePixel = 0,
            Parent = body,
        }, { BackgroundColor3 = "Sidebar" })
        table.insert(self._fadeFrames, rail)
        local line = create(self, "Frame", {
            Size = UDim2.new(0, 1, 1, 0),
            BorderSizePixel = 0,
            Parent = rail,
        }, { BackgroundColor3 = "Outline" })
        if side == "Right" then
            rail.AnchorPoint = Vector2.new(1, 0)
            rail.Position = UDim2.new(1, 0, 0, 0)
        else
            line.AnchorPoint = Vector2.new(1, 0)
            line.Position = UDim2.new(1, 0, 0, 0)
        end
        textLabel(self, {
            Text = titleText,
            Font = FONT_BOLD,
            TextSize = 13,
            Size = UDim2.new(1, -28, 0, 16),
            Position = UDim2.new(0, 14, 0, 12),
            Parent = rail,
        }, "SubText")
        local scroll = create(self, "ScrollingFrame", {
            Name = "Scroll",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0, 34),
            Size = UDim2.new(1, 0, 1, -34),
            ScrollBarThickness = 2,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Parent = rail,
        }, { ScrollBarImageColor3 = "Accent" })
        pad(scroll, 8, 4, 8, 24)
        list(scroll, 6)
        return rail, scroll
    end

    local leftRail, leftScroll = buildRail("Left", LW, opts.LeftTitle or "Tabs")
    local rightRail, rightScroll = buildRail("Right", RW, opts.RightTitle or "Quick")
    self._leftScroll = leftScroll
    self.Left = newContainer(self, leftScroll, Container)
    self.Right = newContainer(self, rightScroll, Container)

    -- middle: channel bar, pages, profile, footer
    local mid = create(self, "Frame", {
        Name = "Middle",
        Position = UDim2.new(0, LW, 0, 0),
        Size = UDim2.new(1, -(LW + RW), 1, 0),
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = body,
    }, { BackgroundColor3 = "Panel" })
    table.insert(self._fadeFrames, mid)

    local chBar = create(self, "Frame", {
        Name = "ChannelBar",
        Size = UDim2.new(1, 0, 0, 40),
        BorderSizePixel = 0,
        Parent = mid,
    }, { BackgroundColor3 = "Panel" })
    table.insert(self._fadeFrames, chBar)
    create(self, "Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 1),
        BorderSizePixel = 0,
        Parent = chBar,
    }, { BackgroundColor3 = "Outline" })
    self._chBar = chBar

    local pages = create(self, "Frame", {
        Name = "Pages",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 41),
        Size = UDim2.new(1, 0, 1, -(41 + PROFILE_H)),
        ClipsDescendants = true,
        Parent = mid,
    })
    self._pages = pages

    -- roblox profile card
    local profile = create(self, "Frame", {
        Name = "Profile",
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -(FOOTER_H + 2)),
        Size = UDim2.new(1, -28, 0, 54),
        BorderSizePixel = 0,
        Parent = mid,
    }, { BackgroundColor3 = "Element" })
    local pc = Instance.new("UISizeConstraint")
    pc.MaxSize = Vector2.new(380, 54)
    pc.Parent = profile
    corner(profile, 6)
    stroke(self, profile, "Outline")

    local avatar = create(self, "ImageLabel", {
        Size = UDim2.fromOffset(38, 38),
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 8, 0.5, 0),
        BorderSizePixel = 0,
        Image = "",
        Parent = profile,
    }, { BackgroundColor3 = "Track" })
    corner(avatar, 5)

    local player = LocalPlayer
    local nameLabel = textLabel(self, {
        Text = player and player.DisplayName or "Player",
        Font = FONT_BOLD,
        TextSize = 15,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -140, 0, 18),
        Position = UDim2.new(0, 56, 0, 9),
        Parent = profile,
    }, "Text")
    local userLabel = textLabel(self, {
        Text = "@" .. (player and player.Name or "player"),
        Font = FONT_REG,
        TextSize = 13,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -140, 0, 14),
        Position = UDim2.new(0, 56, 0, 28),
        Parent = profile,
    }, "SubText")
    local statsLabel = textLabel(self, {
        Text = "-- fps\n-- ms",
        Font = FONT_MED,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Size = UDim2.fromOffset(66, 34),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Visible = opts.ShowStats ~= false,
        Parent = profile,
    }, "SubText")

    self._profile = profile
    self._profileAvatar = avatar
    self._profileName = nameLabel
    self._profileUser = userLabel

    -- fixed footer text under the profile. plain TextLabel, no API touches it
    textLabel(self, {
        Name = "Footer",
        Text = "SAR UI",
        Font = FONT_BOLD,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.new(1, 0, 0, 16),
        AnchorPoint = Vector2.new(0.5, 1),
        Position = UDim2.new(0.5, 0, 1, -5),
        Parent = mid,
    }, "SubText")

    self:SetProfile({ UserId = player and player.UserId or 1 })

    local frames, last = 0, os.clock()
    self:_connect(RunService.Heartbeat, function()
        frames += 1
    end)
    task.spawn(function()
        while not self._destroyed do
            task.wait(0.5)
            if self._destroyed then
                break
            end
            local now = os.clock()
            local fps = math.floor(frames / math.max(now - last, 0.001) + 0.5)
            frames, last = 0, now
            local ping = 0
            pcall(function()
                ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
            end)
            statsLabel.Text = fps .. " fps\n" .. ping .. " ms"
        end
    end)

    if opts.ShowProfile == false then
        self:SetProfileVisible(false)
    end

    -- resize grip, two little diagonal lines
    local grip = create(self, "TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -2, 1, -2),
        Size = UDim2.fromOffset(16, 16),
        ZIndex = 5,
        Parent = main,
    })
    bar(self, grip, 5, 1, 11.5, 11.5, -45, "SubText").ZIndex = 5
    bar(self, grip, 10, 1, 8.5, 8.5, -45, "SubText").ZIndex = 5
    if opts.Resizable ~= false then
        local startMouse, startSize, startPos
        bindDrag(self, grip, function(pos)
            local d = pos - startMouse
            local w = math.max(startSize.X + d.X, 640)
            local h = math.max(startSize.Y + d.Y, 420)
            main.Size = UDim2.fromOffset(w, h)
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + (w - startSize.X) / 2,
                startPos.Y.Scale, startPos.Y.Offset + (h - startSize.Y) / 2
            )
        end, function(pos)
            dragTarget = nil
            startMouse = pos
            startSize = main.AbsoluteSize
            startPos = main.Position
        end)
    else
        grip.Visible = false
    end

    -- notifications
    local notif = create(self, "Frame", {
        Name = "Notifications",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.new(0, 300, 1, -32),
        Parent = gui,
    })
    list(notif, 8, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
    self._notifHolder = notif

    -- floating open button (shows when the window is hidden)
    local openBtn = create(self, "TextButton", {
        Name = "OpenButton",
        Text = "S",
        Font = FONT_BOLD,
        TextSize = 20,
        AutoButtonColor = false,
        Size = UDim2.fromOffset(42, 42),
        Position = UDim2.new(0, 20, 0.5, -21),
        BorderSizePixel = 0,
        Visible = false,
        Parent = gui,
    }, { BackgroundColor3 = "Accent", TextColor3 = "AccentText" })
    corner(openBtn, 6)
    stroke(self, openBtn, "Outline")
    self._openButton = openBtn

    local btnStartMouse, btnStartPos, moved = nil, nil, false
    bindDrag(self, openBtn, function(pos)
        local d = pos - btnStartMouse
        if d.Magnitude > 5 then
            moved = true
        end
        openBtn.Position = UDim2.new(
            btnStartPos.X.Scale, btnStartPos.X.Offset + d.X,
            btnStartPos.Y.Scale, btnStartPos.Y.Offset + d.Y
        )
    end, function(pos)
        btnStartMouse = pos
        btnStartPos = openBtn.Position
        moved = false
    end)
    openBtn.MouseButton1Click:Connect(function()
        if moved then
            moved = false
            return
        end
        self:Toggle(true)
    end)

    minBtn.MouseButton1Click:Connect(function()
        self:Toggle(false)
        if not self._floating then
            self:Notify({
                Title = self.Title .. " hidden",
                Content = "Press " .. self.ToggleKey.Name .. " to open it again.",
                Duration = 3,
            })
        end
    end)
    closeBtn.MouseButton1Click:Connect(function()
        if opts.CloseConfirm == false then
            self:Destroy()
            return
        end
        self:Dialog({
            Title = "Close " .. self.Title,
            Content = "Close this window?",
            Buttons = {
                { Title = "Cancel" },
                { Title = "Close", Variant = "Danger", Callback = function() self:Destroy() end },
            },
        })
    end)

    self:_connect(UserInputService.InputBegan, function(input, processed)
        if processed then
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == self.ToggleKey then
            self:Toggle()
        end
    end)

    table.insert(SAR.Windows, self)
    return self
end

---------------------------------------------------------------- library helpers

function SAR:AddTheme(name, data)
    SAR.Themes[name] = derive(Dark, data)
end

function SAR:Notify(opts)
    local w = SAR.Windows[#SAR.Windows]
    if w then
        return w:Notify(opts)
    end
end

function SAR:DestroyAll()
    for i = #SAR.Windows, 1, -1 do
        SAR.Windows[i]:Destroy()
    end
end

return SAR
