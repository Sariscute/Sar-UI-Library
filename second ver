--[[
    SAR UI - custom Roblox Luau UI library

    left rail = search + tabs, middle = channels + pages + profile, right rail = quick buttons

    local SAR = loadstring(readfile("SAR_UI.lua"))()
    local Window = SAR:CreateWindow({ Title = "SAR UI" })

    local Tab = Window:Tab({ Title = "Home" })
    local General = Tab:Channel("general")
    General:Button({ Title = "Hello", Callback = function() end })

    Window.Right:Button({ Title = "Quick action", Callback = function() end })
    Window:CreateSettingsTab()

    CreateWindow options (extra):
        LoadingScreen = false   skip the loading screen
        LoadingTime = 2.8       loading screen length in seconds

    mobile / small screens:
        the window fits the screen automatically (portrait and landscape). the tab list
        is never hidden. when the window gets narrow the tab list just gets slimmer and the
        right rail (quick buttons) turns into a slide-in drawer, grid button in the top bar.
        short windows (phone in landscape) drop the rail titles, footer and profile card to
        give the pages more height.
        controls get bigger touch targets on touch devices, sliders / color pickers no
        longer fight with page scrolling, and key chips are hidden when there is no keyboard.
        Compact = true / false      force the compact layout on or off (default: automatic)
        CompactBreakpoint = 680     window width under which the compact layout kicks in
        window:SetLayout("Auto" | "Compact" | "Desktop")

    elements (Channel, Section, Window.Left, Window.Right):
        Label, Paragraph, Button, Toggle, Slider, Dropdown, Input,
        Keybind, ColorPicker, Divider, Section

    Button/Toggle key chips:
        Keybind = Enum.KeyCode.F or "F" or true (true starts unbound)
        KeybindMode = "Toggle" or "Hold" (Toggle only)
        KeybindChanged = function(key) end

    window:
        Tab, SelectTab, Search, Notify, Dialog, Toggle, SetTheme, SetAccent,
        SetTransparency, SetTitle, SetProfile, SetProfileVisible, SetLayout,
        SaveConfig, LoadConfig, DeleteConfig, ListConfigs,
        CreateSettingsTab, Destroy

    SetProfile fields:
        DisplayName, Username, UserId, Game   (Game overrides the auto detected game name)
]]

