---------------------------------------------------------------- helpers

local function norm(o)
    if type(o) == "string" then
        return { Title = o }
    end
    return o or {}
end

local function tween(obj, props, time, style, dir)
    local ok, tw = pcall(function()
        local t = TweenService:Create(
            obj,
            TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
            props
        )
        t:Play()
        return t
    end)
    return ok and tw or nil
end

-- runs a user callback on its own thread, errors are swallowed on purpose
local function fire(callback, ...)
    if type(callback) ~= "function" then
        return
    end
    local args = table.pack(...)
    task.spawn(function()
        pcall(callback, table.unpack(args, 1, args.n))
    end)
end

local function fsAvailable()
    return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

local function encodeValue(v)
    local tv = typeof(v)
    if tv == "Color3" then
        return { __t = "Color3", r = v.R, g = v.G, b = v.B }
    elseif tv == "EnumItem" then
        return { __t = "KeyCode", n = v.Name }
    end
    return v
end

local function decodeValue(v)
    if type(v) == "table" and v.__t == "Color3" then
        return Color3.new(v.r, v.g, v.b)
    elseif type(v) == "table" and v.__t == "KeyCode" then
        return v.n and Enum.KeyCode[v.n] or nil
    end
    return v
end

-- size of the screen the gui lives on (falls back to the camera before the gui has laid out)
local function viewportSize(gui)
    local a = gui and gui.AbsoluteSize
    if a and a.X > 0 and a.Y > 0 then
        return a
    end
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

-- window size when the script doesn't pass one: fills small screens, caps on big ones
local function defaultWindowSize(vs)
    -- narrow screen (phone in portrait): fill it
    if vs.X < 720 then
        return UDim2.fromOffset(math.max(vs.X - 16, 240), math.max(math.min(vs.Y - 16, 720), 240))
    end
    -- short screen (phone in landscape): use the full width and almost the full height,
    -- with a wider side margin on touch devices so notches / rounded corners don't cut it
    if vs.Y < 480 then
        local side = sz(12, 28)
        return UDim2.fromOffset(math.max(vs.X - side * 2, 240), math.max(vs.Y - 12, 240))
    end
    local margin = sz(24, 12)
    return UDim2.fromOffset(math.min(860, vs.X - margin), math.max(math.min(540, vs.Y - margin), 240))
end

