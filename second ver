        Visible = false,
        Parent = win._pages,
    }, { ScrollBarImageColor3 = "Accent" })
    pad(page, 14, 12, 14, 12)
    list(page, 8)

    local ch = newContainer(win, page, Channel)
    ch.Tab = self
    ch.Title = title
    ch._button = btn
    ch._label = lbl
    ch._underline = underline
    ch._page = page

    table.insert(self.Channels, ch)

    if not MOBILE then
        btn.MouseEnter:Connect(function()
            if self.SelectedChannel ~= ch then
                tween(btn, { BackgroundTransparency = 0.6 }, 0.1)
            end
        end)
        btn.MouseLeave:Connect(function()
            if self.SelectedChannel ~= ch then
                tween(btn, { BackgroundTransparency = 1 }, 0.1)
            end
        end)
    end
    btn.MouseButton1Click:Connect(function()
        self:SelectChannel(ch)
    end)

    if not self.SelectedChannel then
        self:SelectChannel(ch)
    else
        self:_visual()
    end
    return ch
end

function Tab:SelectChannel(ch)
    if type(ch) == "string" then
        for _, c in ipairs(self.Channels) do
            if c.Title == ch then
                ch = c
                break
            end
        end
    end
    if type(ch) ~= "table" then
        return
    end
    if self.SelectedChannel and self.SelectedChannel ~= ch then
        self.SelectedChannel._page.Visible = false
    end
    self.SelectedChannel = ch
    ch._page.Visible = (self.Window.SelectedTab == self)
    self:_visual()
end

function Tab:_visual()
    local win = self.Window
    local t = win.Theme
    local selected = win.SelectedTab == self
    tween(self._button, { BackgroundTransparency = selected and 0 or 1 }, 0.15)
    self._indicator.Visible = selected
    self._label.TextColor3 = selected and t.Text or t.SubText
    setIconColor(self._icon, selected and t.Accent or t.SubText)
    for _, ch in ipairs(self.Channels) do
        local sel = self.SelectedChannel == ch
        tween(ch._button, { BackgroundTransparency = sel and 0 or 1 }, 0.15)
        ch._label.TextColor3 = sel and t.Text or t.SubText
        ch._underline.Visible = sel
    end
end

function Tab:_default()
    if not self._defaultChannel then
        self._defaultChannel = self:Channel({ Title = self.DefaultChannelName })
    end
    return self._defaultChannel
end

for _, name in ipairs(ELEMENT_NAMES) do
    Tab[name] = function(self, ...)
        local ch = self:_default()
        return ch[name](ch, ...)
    end
end

function Tab:Select()
    self.Window:SelectTab(self)
end

function Window:Tab(opts)
    opts = norm(opts)
    local title = opts.Title or "Tab"

    local tab = setmetatable({
        Window = self,
        Title = title,
        Icon = opts.Icon,
        Channels = {},
