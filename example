            UserId = LocalPlayer.UserId,
        })
    end,
})
Profile:Input({
    Title = "Show another user",
    Desc = "Type a Roblox UserId and press Enter (avatar + name)",
    Placeholder = "1",
    Numeric = true,
    OnEnterOnly = true,
    Callback = function(text)
        local id = tonumber(text)
        if not id then
            return
        end
        local ok, name = pcall(function()
            return Players:GetNameFromUserIdAsync(id)
        end)
        if ok then
            Window:SetProfile({ DisplayName = name, Username = name, UserId = id })
        else
            notify("Lookup failed", "No user with that id", "Error")
        end
    end,
})
Profile:Toggle({
    Title = "Show profile card",
    Default = true,
    CallOnCreate = false,
    Callback = function(v)
        Window:SetProfileVisible(v)
    end,
})

