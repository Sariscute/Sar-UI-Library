---------------------------------------------------------------- TAB 3: Teleport

local TeleTab = Window:Tab({ Title = "Teleport", Icon = "T" })
local Targets = TeleTab:Channel("players")

local playersLabel -- lives in the right rail, filled in below
local playerDropdown

local function getTarget()
    local name = playerDropdown and playerDropdown:Get()
    local p = name and Players:FindFirstChild(name)
    if p and p:IsA("Player") then
        return p
    end
end

local function refreshPlayers()
    playerDropdown:Refresh(otherPlayers(), true)
    if playersLabel then
        playersLabel:Set("Players in server: " .. #Players:GetPlayers())
    end
end

playerDropdown = Targets:Dropdown({
    Title = "Target player",
    Desc = "List updates when people join or leave",
    Values = otherPlayers(),
    Placeholder = "pick a player",
})
Targets:Button({
    Title = "Teleport to player",
    Callback = function()
        local target = getTarget()
        local root = getRoot()
        local targetRoot = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if root and targetRoot then
            root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
            notify("Teleported", "to " .. target.Name, "Success")
        else
            notify("Cannot teleport", "pick a player with a loaded character", "Warning")
        end
    end,
})
Targets:Toggle({
    Title = "Spectate player",
    Callback = function(v)
        local target = getTarget()
        local targetHum = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
        if v and targetHum then
            getCamera().CameraSubject = targetHum
        else
            local hum = getHumanoid()
            if hum then
                getCamera().CameraSubject = hum
            end
        end
    end,
})
Targets:Input({
    Title = "Find by name",
    Desc = "Partial name or display name, then Enter",
    Placeholder = "start typing a name",
    OnEnterOnly = true,
    Callback = function(text)
        if text == "" then
            return
        end
        local p = findPlayer(text)
        if p then
            playerDropdown:Set(p.Name, true)
            notify("Found player", p.DisplayName .. " (@" .. p.Name .. ")", "Success")
        else
            notify("No match", text, "Warning")
        end
    end,
})
Targets:Button({
    Title = "Refresh list",
    Callback = refreshPlayers,
})

track(Players.PlayerAdded:Connect(function()
    task.delay(0.1, refreshPlayers)
end))
track(Players.PlayerRemoving:Connect(function()
    task.delay(0.2, refreshPlayers)
end))

