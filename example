---------------------------------------------------------------- window

local Window = SAR:CreateWindow({
    Title = "SAR UI",
    Subtitle = "full demo",
    Theme = "Dark",
    ToggleKey = Enum.KeyCode.RightShift,
    Folder = "SAR_UI_Demo",
    LeftTitle = "Tabs",
    RightTitle = "Quick",
    LeftWidth = 160,
    RightWidth = 176,
    FloatingButton = true,
    ShowStats = true,
    ShowProfile = true,
    Resizable = true,
    CloseConfirm = true,
    OnDestroy = cleanup,
})

local function notify(title, content, kind, duration)
    return Window:Notify({ Title = title, Content = content, Type = kind or "Info", Duration = duration or 3 })
end

-- theme + toggles are mirrored between the tabs and the right rail
local accentPicker, themeDropdown, railThemeDropdown
local noclipToggle, railNoclip, jumpToggle, railJump

local function applyTheme(name)
    Window:SetTheme(name)
    if themeDropdown then
        themeDropdown:Set(name, true)
    end
    if railThemeDropdown then
        railThemeDropdown:Set(name, true)
    end
    if accentPicker then
        accentPicker:Set(Window.Theme.Accent, true)
    end
end

local function setNoclip(value)
    State.Noclip = value
    if noclipToggle then
        noclipToggle:Set(value, true)
    end
    if railNoclip then
        railNoclip:Set(value, true)
    end
end

local function setInfiniteJump(value)
    State.InfiniteJump = value
    if jumpToggle then
        jumpToggle:Set(value, true)
    end
    if railJump then
        railJump:Set(value, true)
    end
end

