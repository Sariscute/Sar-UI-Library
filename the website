<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SAR UI Builder</title>
<link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f6f8;--pn:#fff;--ln:#dcdce2;--tx:#1d1d22;--mu:#6b6b76;--ac:#d6563e;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#121214;--pn:#1b1b1f;--ln:#2e2e34;--tx:#e6e6ea;--mu:#8c8c96}}
:root[data-theme="dark"]{--bg:#121214;--pn:#1b1b1f;--ln:#2e2e34;--tx:#e6e6ea;--mu:#8c8c96}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.45 Ubuntu,system-ui,sans-serif}
a{color:inherit}
.nav{display:flex;align-items:center;gap:14px;max-width:1400px;margin:0 auto;padding:14px}
.nav b{font-size:18px}.nav span{color:var(--mu);font-size:13px;border:1px solid var(--ln);border-radius:4px;padding:1px 7px}
.nav a{margin-left:auto;color:var(--mu);text-decoration:none}
.hero{max-width:1400px;margin:0 auto;padding:36px 14px 26px}
.hero h1{font-size:clamp(28px,5vw,44px);margin:0 0 8px;line-height:1.1}
.hero p{color:var(--mu);margin:0 0 18px;max-width:520px}
.b{font:inherit;color:inherit;background:var(--pn);border:1px solid var(--ln);border-radius:5px;padding:6px 12px;cursor:pointer;text-decoration:none;display:inline-block}
.b.p{background:var(--ac);border-color:var(--ac);color:#fff}.b.d{color:#d6453e}
.grid{display:grid;grid-template-columns:240px minmax(0,1fr) 320px;gap:14px;max-width:1400px;margin:0 auto;padding:0 14px 40px;align-items:start}
.pn{background:var(--pn);border:1px solid var(--ln);border-radius:6px;padding:12px}
h3{margin:4px 0 8px;font-size:13px;color:var(--mu);font-weight:500;text-transform:none}
label{display:block;font-size:13px;color:var(--mu)}
label.ck{display:flex;gap:8px;align-items:center;margin-bottom:8px}
input,select,textarea{width:100%;font:inherit;font-size:14px;color:var(--tx);background:var(--bg);border:1px solid var(--ln);border-radius:4px;padding:6px 8px;margin:3px 0 8px}
input[type=checkbox]{width:auto;margin:0}input[type=color]{height:32px;padding:2px}
textarea{font-family:ui-monospace,Consolas,monospace;font-size:12px}
.row{display:flex;gap:6px;flex-wrap:wrap}.mu{color:var(--mu)}
.adds{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
#out{height:300px;white-space:pre;overflow:auto;margin:6px 0}
#pv{background:var(--b);color:var(--t);border:1px solid var(--o);border-radius:6px;overflow:hidden;font-size:14px}
#pv .top{display:flex;gap:8px;align-items:center;padding:0 12px;height:42px;background:var(--e);border-bottom:1px solid var(--o)}
#pv .logo{background:var(--a);color:#fff;border-radius:4px;width:22px;height:22px;display:grid;place-items:center;font-weight:700}
#pv .pl{background:var(--b);color:var(--s);border-radius:4px;padding:0 7px;font-size:12px}
#pv .body{display:grid;grid-template-columns:130px minmax(0,1fr) 150px;min-height:360px}
#pv .rail{padding:8px;border-right:1px solid var(--o);display:flex;flex-direction:column;gap:4px;background:var(--e)}
#pv .rail.r{border:0;border-left:1px solid var(--o)}
#pv .ti{padding:8px 10px;border-radius:5px;cursor:pointer;color:var(--s)}
#pv .ti.on{background:var(--b);color:var(--t);box-shadow:inset 3px 0 var(--a)}
#pv .cbar{display:flex;gap:4px;padding:6px 8px;border-bottom:1px solid var(--o);overflow-x:auto}
#pv .ch{padding:5px 10px;border-radius:4px;cursor:pointer;color:var(--s);white-space:nowrap}
#pv .ch.on{background:var(--e);color:var(--t);box-shadow:inset 0 -2px var(--a)}
#pv .pg{padding:12px;display:flex;flex-direction:column;gap:8px;min-height:270px;max-height:480px;overflow-y:auto}
#pv .cd{background:var(--e);border:1px solid var(--o);border-radius:5px;padding:10px 12px;cursor:pointer}
#pv .cd.sel{border-color:var(--a)}
#pv .hd{display:flex;justify-content:space-between;align-items:center;gap:8px}
#pv .ds,#pv .sb,#pv .lb,#pv .ft{color:var(--s);font-size:13px}#pv .ds{white-space:pre-wrap}.ft{text-align:center;padding:8px}
#pv .tg{width:36px;height:18px;border-radius:4px;background:var(--o);position:relative;flex:none}
#pv .tg:after{content:"";position:absolute;left:3px;top:3px;width:12px;height:12px;border-radius:3px;background:#fff}
#pv .tg.on{background:var(--a)}#pv .tg.on:after{left:21px}
#pv .chev{width:7px;height:7px;border:solid var(--a);border-width:0 2px 2px 0;transform:rotate(-45deg);margin-right:6px}
#pv .sw{width:36px;height:20px;border-radius:4px;background:var(--a)}
#pv .kb,#pv .fd{border:1px solid var(--o);border-radius:4px;padding:4px 10px;font-size:13px;background:var(--b)}#pv .fd{margin-top:8px}
#pv .sl{height:4px;background:var(--o);border-radius:2px;margin-top:10px}#pv .sl b{display:block;height:100%;background:var(--a);border-radius:2px}
#pv hr{border:0;border-top:1px solid var(--o);width:100%;margin:4px 0;cursor:pointer}
.imp{width:calc(100% - 28px);max-width:1372px;margin:0 auto 14px}
@media(max-width:1000px){.grid{grid-template-columns:1fr}}
@media(max-width:640px){#pv .body{grid-template-columns:90px 1fr}#pv .rail.r{grid-column:1/-1;border-left:0;border-top:1px solid var(--o)}}
</style>
</head>
<body>
<div class="nav"><b>SAR UI</b><span>builder</span><a href="https://github.com/Sariscute/Sar-UI-Library">GitHub</a></div>
<section class="hero"><h1>Build scripts with SAR UI</h1><p>Lay out tabs, channels and elements, see them live, then copy the Lua.</p><a class="b p" href="#build">Start building</a></section>
<section class="pn imp"><h3>Convert a script</h3><p class="mu" style="margin:0 0 8px;font-size:13px">Paste a script made with WindUI, Rayfield, Orion, Fluent or Kavo. It turns into a SAR UI layout you can edit below.</p><textarea autocomplete="off" id="src" rows="5" spellcheck="false" placeholder="Paste a script here"></textarea><button class="b p" data-a="conv">Convert</button> <span class="mu" id="cmsg" style="font-size:13px"></span></section>
<main class="grid" id="build">
<aside class="pn"><h3>Window</h3>
<label>Title<input autocomplete="off" data-w="title"></label><label>Subtitle<input autocomplete="off" data-w="sub"></label>
<label>Theme<select autocomplete="off" data-w="theme" id="th"></select></label>
<label>Accent<input autocomplete="off" type="color" data-w="accent" id="ac"></label>
<label class="ck"><input autocomplete="off" type="checkbox" data-w="settings">Settings tab</label>
<label>Other window options (raw Lua)<textarea autocomplete="off" data-w="x" rows="3" spellcheck="false" placeholder="Size = UDim2.fromOffset(860, 540)"></textarea></label>
<div id="st"></div></aside>
<section><div id="pv"></div><p class="mu" id="tgt" style="font-size:13px;margin:10px 0 0"></p><div class="adds" id="adds"></div></section>
<aside><div class="pn" id="pr"></div>
<div class="pn" style="margin-top:14px"><h3>Script code (runs before the elements are added)</h3><textarea autocomplete="off" data-p="pre" rows="6" spellcheck="false" placeholder="local functions, variables, services, loops your buttons use. Tabs and channels already exist here."></textarea><h3>Script code (runs after the UI)</h3><textarea autocomplete="off" data-p="post" rows="4" spellcheck="false" placeholder="code that should run after the UI is built"></textarea></div>
<div class="pn" style="margin-top:14px"><h3>Lua</h3><textarea autocomplete="off" id="out" spellcheck="false"></textarea>
<button class="b p" data-a="copy">Copy code</button>
<p class="mu" style="font-size:13px">You can edit the Lua above and the preview follows. Changing something in the builder rewrites the Lua.</p></div></aside>
</main>
<script>
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const T={Dark:['#121214','#1e1e22','#2e2e34','#de624a'],Midnight:['#0b0d16','#151928','#232940','#568ce6'],Light:['#f0f0f3','#fcfcfd','#dbdbe3','#d6563e'],Rose:['#160f12','#24191e','#3c2b33','#e86086'],Emerald:['#0d1412','#16221e','#253a32','#3cbe8c'],Crimson:['#120c0c','#201515','#3a2626','#dc3a3a']};
const K=['Button','Toggle','Slider','Dropdown','Input','Keybind','ColorPicker','Label','Paragraph','Divider'];
const NEW={Slider:{min:0,max:100,def:50},Dropdown:{vals:'One, Two, Three'},Toggle:{def:false},Keybind:{def:'F'}};
const A={Button:'',Toggle:'state',Slider:'value',Dropdown:'value',Input:'text',Keybind:'key',ColorPicker:'color'};
const KW=/^(and|break|do|else|elseif|end|false|for|function|goto|if|in|local|nil|not|or|repeat|return|then|true|until|while|continue)$/;
try{localStorage.removeItem('sarb')}catch(e){}
let S={w:{title:'My Script',sub:'SAR UI',theme:'Midnight',accent:'',settings:true,x:[]},pre:'',post:'',tabs:[{t:'Main',ch:[{t:'general',el:[]}]}],ti:0,ci:0,sel:-1};
S.q=S.q||[];
const tab=()=>S.tabs[S.ti],chan=()=>tab().ch[S.ci],els=()=>S.qm?S.q:chan().el;

/* ---------- preview ---------- */
function card(e,i,rq){
 const s=`data-a="${rq?'qsel':'sel'}" data-i="${i}"`;
 if(e.k=='Divider')return`<hr ${s}>`;
 if(e.k=='Label')return`<div class="lb" ${s}>${esc(e.t)}</div>`;
 let c='',b='';
 if(e.k=='Button')c='<i class="chev"></i>';
 if(e.k=='Toggle')c=`<i class="tg${e.def?' on':''}"></i>`;
 if(e.k=='ColorPicker')c='<i class="sw"></i>';
 if(e.k=='Keybind')c=`<i class="kb">${esc(e.def||'none')}</i>`;
 if(e.k=='Slider'){const p=Math.max(0,Math.min(100,(e.def-e.min)/((e.max-e.min)||1)*100));b=`<div class="sl"><b style="width:${p}%"></b></div>`}
 if(e.k=='Dropdown')b=`<div class="fd">${esc(String(e.vals||'').split(',')[0].trim()||(e.vr?'('+e.vr+')':'none'))}</div>`;
 if(e.k=='Input')b='<div class="fd sb">enter text</div>';
 return`<div class="cd${S.sel==i&&!!S.qm==rq?' sel':''}" ${s}><div class="hd"><div><div>${esc(e.t)}</div>${e.d?`<div class="ds">${esc(e.d)}</div>`:''}</div>${c}</div>${b}</div>`}
function preview(){
 const c=T[S.w.theme]||T.Dark,a=S.w.accent||c[3],lt=S.w.theme=='Light';
 $('#pv').style.cssText=`--b:${c[0]};--e:${c[1]};--o:${c[2]};--a:${a};--t:${lt?'#1e1e24':'#e2e2e6'};--s:${lt?'#6c6c78':'#8a8a94'}`;
 $('#pv').innerHTML=`<div class="top"><span class="logo">S</span><b>${esc(S.w.title)}</b><span class="pl">${esc(S.w.sub)}</span></div><div class="body"><div class="rail">${S.tabs.map((t,i)=>`<div class="ti${i==S.ti?' on':''}" data-a="tab" data-i="${i}">${esc(t.t)}</div>`).join('')}<div class="ti" data-a="addtab">+ tab</div>${S.w.settings?'<div class="ti">Settings</div>':''}</div><div><div class="cbar">${tab().ch.map((c,j)=>`<span class="ch${j==S.ci?' on':''}" data-a="ch" data-i="${j}"># ${esc(c.t)}</span>`).join('')}<span class="ch" data-a="addch">+</span></div><div class="pg">${chan().el.map((e,i)=>card(e,i,false)).join('')||'<span class="sb">Empty channel. Add elements below.</span>'}</div><div class="ft">SAR UI</div></div><div class="rail r"><b class="sb">Quick actions</b>${S.q.map((e,i)=>card(e,i,true)).join('')}<div class="ti" data-a="qmode">+ add here</div></div></div>`}

/* ---------- Lua generation ---------- */
const q=s=>'"'+String(s??'').replace(/\\/g,'\\\\').replace(/"/g,'\\"').replace(/\r?\n/g,'\\n')+'"';
// multi-line text becomes a long-bracket string so it stays readable
const qq=s=>{s=String(s??'');if(!s.includes('\n'))return q(s);let l='';while(s.includes(']'+l+']'))l+='=';return'['+l+'['+'\n'+s+']'+l+']'};
const ex=(arr,ind)=>{const o=[];(arr||[]).forEach(s=>{s=String(s).trim();if(!s)return;const ls=s.split('\n');ls[0]=ind+ls[0];o.push(...ls);if(/--/.test(ls[ls.length-1]))o.push(ind+',');else o[o.length-1]+=','});return o};
function eg(e,v){
 if(e.k=='Divider')return[`${v}:Divider()`];
 if(e.k=='Label')return[`${v}:Label({ Title = ${e.tr?e.t:q(e.t)} })`];
 const r=[`${v}:${e.k}({`,`    Title = ${e.tr?e.t:q(e.t)},`];
 if(e.d)r.push(`    ${e.k=='Paragraph'?'Content':'Desc'} = ${e.dr?e.d:qq(e.d)},`);
 if(e.k=='Toggle')r.push(`    Default = ${!!e.def},`);
 if(e.k=='Slider')r.push(`    Min = ${+e.min||0},`,`    Max = ${+e.max||100},`,`    Default = ${+e.def||0},`);
 if(e.k=='Dropdown')r.push(e.vr?`    Values = ${e.vr},`:`    Values = { ${String(e.vals||'').split(',').map(s=>s.trim()).filter(Boolean).map(q).join(', ')} },`);
 if(e.k=='Keybind'&&e.def)r.push(`    Default = Enum.KeyCode.${String(e.def).replace(/\W/g,'')},`);
 r.push(...ex(e.x,'    '));
 if(e.k in A){r.push(`    Callback = function(${e.ca||A[e.k]})`);(e.cb||'-- your code here').split('\n').forEach(l=>r.push('        '+l));r.push('    end,')}
 r.push('})');return r}
function gen(){
 const w=S.w,L=['local SAR = loadstring(game:HttpGet("https://raw.githubusercontent.com/Sariscute/Sar-UI-Library/refs/heads/main/second%20ver"))()','','local Window = SAR:CreateWindow({',`    Title = ${q(w.title)},`,`    Subtitle = ${q(w.sub)},`,`    Theme = ${q(w.theme)},`,...ex(w.x,'    '),'})'];
 if(w.accent)L.push(`Window:SetAccent(Color3.fromHex(${q(w.accent)}))`);
 // tabs and channels are created first, so your own code (and any loop that makes UI) can already use them
 const used=new Set(['SAR','Window']);
 const uniq=(v,d)=>{let n=v&&/^[A-Za-z_]\w*$/.test(v)&&!KW.test(v)&&!used.has(v)?v:d;while(used.has(n))n+='_';used.add(n);return n};
 S.tabs.forEach((t,i)=>{t._n=uniq(t.v,'Tab'+(i+1))});
 S.tabs.forEach((t,i)=>t.ch.forEach((c,j)=>{c._n=uniq(c.v,`Channel${i+1}_${j+1}`)}));
 S.tabs.forEach(t=>{L.push('',`local ${t._n} = Window:Tab({ Title = ${q(t.t)} })`);t.ch.forEach(c=>L.push(`local ${c._n} = ${t._n}:Channel(${q(c.t)})`))});
 if(S.pre)L.push('',S.pre);
 if(S.q.length){L.push('');S.q.forEach(e=>L.push(...eg(e,'Window.Right')))}
 S.tabs.forEach(t=>t.ch.forEach(c=>{if(c.el.length){L.push('');c.el.forEach(e=>L.push(...eg(e,c._n)))}}));
 if(w.settings)L.push('','Window:CreateSettingsTab()');
 if(S.post)L.push('',S.post);
 return L.join('\n')}

/* ---------- element editor ---------- */
function props(){
 const e=els()[S.sel],P=$('#pr');
 if(!e){P.innerHTML='<h3>Element</h3><p class="mu">Add an element below the preview, then click it to edit.</p>';return}
 const f=(k,l,v,ty='text')=>`<label>${l}<input type="${ty}" data-f="${k}" value="${esc(v)}"></label>`;
 let h=`<h3>${e.k}</h3>`;
 if(e.k!='Divider')h+=f('t',e.k=='Label'?'Text':'Title',e.t);
 if(!['Label','Divider'].includes(e.k))h+=f('d',e.k=='Paragraph'?'Content':'Description',e.d);
 if(e.k=='Toggle')h+=`<label class="ck"><input type="checkbox" data-f="def"${e.def?' checked':''}>On by default</label>`;
 if(e.k=='Slider')h+=f('min','Min',e.min,'number')+f('max','Max',e.max,'number')+f('def','Default',e.def,'number');
 if(e.k=='Dropdown')h+=f('vals','Values (comma separated)',e.vals)+(e.vr?`<p class="mu" style="font-size:12px;margin:-4px 0 8px">Linked to <code>${esc(e.vr)}</code> in your script. Editing the list replaces the link.</p>`:'');
 if(e.k=='Keybind')h+=f('def','Key name (for example F)',e.def);
 if(!['Label','Divider'].includes(e.k))h+=`<label>Other options (raw Lua, one per line)<textarea data-f="x" rows="3" spellcheck="false" placeholder="Increment = 10">${esc((e.x||[]).join(',\n'))}</textarea></label>`;
 if(e.k in A)h+=`<label>Callback code${A[e.k]?` (${e.ca||A[e.k]})`:''}<textarea data-f="cb" rows="4" spellcheck="false">${esc(e.cb)}</textarea></label>`;
 P.innerHTML=h+'<div class="row"><button class="b" data-a="up">Up</button><button class="b" data-a="down">Down</button><button class="b d" data-a="del">Remove</button></div>'}
function side(){$('#st').innerHTML=`<h3>Tab</h3><label>Name<input data-n="t" value="${esc(tab().t)}"></label><button class="b d" data-a="deltab">Delete tab</button><h3 style="margin-top:14px">Channel</h3><label>Name<input data-n="c" value="${esc(chan().t)}"></label><button class="b d" data-a="delch">Delete channel</button>`}
function draw(skip){preview();if(!skip)$('#out').value=gen();$('#tgt').textContent=S.qm?'Adding to: quick actions (right rail)':'Adding to: # '+chan().t}
function full(){draw();props();side()}
document.addEventListener('click',ev=>{
 const t=ev.target.closest('[data-a]');if(!t)return;
 const a=t.dataset.a,i=+t.dataset.i;
 if(['tab','ch','addtab','addch','deltab','delch','sel'].includes(a))S.qm=false;
 const L=els();
 if(a=='copy'){const o=$('#out');o.select();let ok=false;try{ok=document.execCommand('copy')}catch(e){}if(!ok&&navigator.clipboard)navigator.clipboard.writeText(o.value).catch(()=>{});t.textContent='Copied';setTimeout(()=>t.textContent='Copy code',1200);return}
 if(a=='conv'){run();return}
 if(a=='tab'){S.ti=i;S.ci=0;S.sel=-1}
 else if(a=='ch'){S.ci=i;S.sel=-1}
 else if(a=='addtab'){S.tabs.push({t:'Tab '+(S.tabs.length+1),ch:[{t:'general',el:[]}]});S.ti=S.tabs.length-1;S.ci=0;S.sel=-1}
 else if(a=='addch'){tab().ch.push({t:'channel '+(tab().ch.length+1),el:[]});S.ci=tab().ch.length-1;S.sel=-1}
 else if(a=='deltab'&&S.tabs.length>1){S.tabs.splice(S.ti,1);S.ti=0;S.ci=0;S.sel=-1}
 else if(a=='delch'&&tab().ch.length>1){tab().ch.splice(S.ci,1);S.ci=0;S.sel=-1}
 else if(a=='add'){const k=t.dataset.k;L.push({k,t:k=='Label'?'Section label':k,d:'',cb:'',x:[],...NEW[k]});S.sel=L.length-1}
 else if(a=='sel')S.sel=i;
 else if(a=='qsel'){S.qm=true;S.sel=i}
 else if(a=='qmode'){S.qm=true;S.sel=-1}
 else if(a=='up'&&S.sel>0){[L[S.sel-1],L[S.sel]]=[L[S.sel],L[S.sel-1]];S.sel--}
 else if(a=='down'&&S.sel<L.length-1){[L[S.sel+1],L[S.sel]]=[L[S.sel],L[S.sel+1]];S.sel++}
 else if(a=='del'){L.splice(S.sel,1);S.sel=-1}
 full()});
document.addEventListener('input',ev=>{
 const t=ev.target;
 if(t.id=='out'){lsync();return}
 if(t.id=='src')return;
 const d=t.dataset,v=t.type=='checkbox'?t.checked:t.value;
 if(d.w!==undefined){
  if(d.w=='x')S.w.x=splitTop(v);
  else{S.w[d.w]=v;if(d.w=='theme'){S.w.accent='';$('#ac').value=T[v][3]}}}
 else if(d.n)(d.n=='t'?tab():chan()).t=v;
 else if(d.p)S[d.p]=v;
 else if(d.f){const e=els()[S.sel];
  if(d.f=='x')e.x=splitTop(v);
  else{e[d.f]=t.type=='number'?+v:v;if(d.f=='t')e.tr=0;if(d.f=='d')e.dr=0;if(d.f=='vals')e.vr=''}}
 draw()});

/* ---------- converter: Lua text helpers ---------- */
const MP={};
const un=s=>String(s).replace(/\\(.)/g,(_,c)=>c=='n'?'\n':c=='t'?'\t':c);
const SRE=/(["'])((?:\\.|(?!\1)[^\\])*)\1/g;
const TKR=/(["'])(?:\\.|(?!\1)[^\\])*\1|--\[(=*)\[[\s\S]*?\]\2\]|\[(=*)\[[\s\S]*?\]\3\]|--[^\n]*/;
const mk=x=>new RegExp(TKR.source+'|'+x,'g');            // tokenizer: strings and comments first, then whatever else is asked for
const LIBS=[['SAR UI',/SAR:CreateWindow/],['Rayfield',/Rayfield/],['Fluent',/Fluent/],['WindUI',/WindUI/],['Kavo',/Kavo|CreateLib/],['Venyx',/venyx/i],['Orion',/OrionLib|MakeWindow/],['Linoria',/Linoria|AddLeftGroupbox/]];
const KM={tab:'Tab',page:'Tab',section:'Label',folder:'Label',category:'Label',button:'Button',toggle:'Toggle',slider:'Slider',dropdown:'Dropdown',input:'Input',textbox:'Input',keybind:'Keybind',bind:'Keybind',colorpicker:'ColorPicker',colourpicker:'ColorPicker',label:'Label',paragraph:'Paragraph',divider:'Divider',channel:'Channel',groupbox:'Channel',leftgroupbox:'Channel',rightgroupbox:'Channel',lefttabbox:'Channel',righttabbox:'Channel'};
