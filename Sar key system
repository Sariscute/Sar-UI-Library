local function MakeButton(name, text, size, position, parent, accent)
    local button = Create("TextButton", {
        Name = name,
        Size = size,
        Position = position,

        BackgroundColor3 = accent and Colors.Accent or Colors.Button,
        BorderSizePixel = 0,
        AutoButtonColor = false,

        Text = text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Colors.White,

        ZIndex = 5,
    }, parent)

    Corner(button, 7)

    if not accent then
        Stroke(button, Colors.Border, 1, 0.5)
    end

    local normal = accent and Colors.Accent or Colors.Button
    local hover = accent
        and Color3.fromRGB(80, 137, 255)
        or Colors.ButtonHover

    button.MouseEnter:Connect(function()
        Tween(button, 0.16, {
            BackgroundColor3 = hover,
        })
    end)

    button.MouseLeave:Connect(function()
        Tween(button, 0.20, {
            BackgroundColor3 = normal,
        })
    end)

    return button
end

