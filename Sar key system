--========================================================
-- KEY VALIDATION
--========================================================

local submitting = false

local function SubmitKey()
    if submitting then
        return
    end

    local input = string.gsub(Box.Text, "%s+", "")

    if string.lower(input) ~= string.lower(VALID_KEY) then
        SetStatus("Incorrect key. Try again.", Colors.Error)

        task.spawn(function()
            local originalPosition = InputContainer.Position

            for _, offset in ipairs({-5, 5, -4, 4, -2, 2, 0}) do
                if not InputContainer.Parent then
                    break
                end

                Tween(InputContainer, 0.035, {
                    Position = UDim2.new(
                        originalPosition.X.Scale,
                        originalPosition.X.Offset + offset,
                        originalPosition.Y.Scale,
                        originalPosition.Y.Offset
                    ),
                })

                task.wait(0.035)
            end

            if InputContainer.Parent then
                InputContainer.Position = originalPosition
            end
        end)

        return
    end

    if SCRIPT_URL == "" then
        SetStatus("Script URL is not configured.", Colors.Error)
        warn("[SARHUB] SCRIPT_URL is empty.")
        return
    end

    submitting = true
    Submit.Text = "..."

    SetStatus("Key accepted. Loading script...", Colors.Success)

    task.spawn(function()
        local success, result = pcall(function()
            local source = game:HttpGet(SCRIPT_URL, true)

            if type(source) ~= "string" or source == "" then
                error("The script URL returned no content.")
            end

            if type(loadstring) ~= "function" then
                error("loadstring is not available.")
            end

            local compiled, compileError = loadstring(source)

            if not compiled then
                error(compileError or "Unable to compile the script.")
            end

            compiled()
        end)

        if success then
            SetStatus("Script loaded successfully.", Colors.Success)

            task.wait(0.1)

            if renderConnection then
                renderConnection:Disconnect()
            end

            Gui:Destroy()
        else
            warn("[SARHUB] Script loading failed:", result)

            SetStatus("Failed to load script. Check URL.", Colors.Error)
            Submit.Text = "›"
            submitting = false
        end
    end)
end

Submit.MouseButton1Click:Connect(SubmitKey)

Box.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        SubmitKey()
    end
end)

