--========================================================
-- DRAGGING WITH PREMIUM SMOOTH GLIDE
--========================================================

-- A dedicated top strip avoids blocking the buttons.

local DragSurface = Create("TextButton", {
    Name = "DragSurface",
    Size = UDim2.new(1, 0, 0, 30),
    Position = UDim2.new(0, 0, 0, 0),
    BackgroundTransparency = 1,
    Text = "",
    AutoButtonColor = false,
    Active = true,
    ZIndex = 20,
}, Frame)

local dragging = false
local dragStart
local startPosition
local targetPosition = Frame.Position
local activeTouch = nil

local GLIDE_SPEED = 8
local POSITION_EPSILON = 0.05

DragSurface.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = targetPosition

        activeTouch =
            input.UserInputType == Enum.UserInputType.Touch
            and input or nil
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    local isMouse =
        input.UserInputType == Enum.UserInputType.MouseMovement

    local isTouch =
        activeTouch ~= nil and input == activeTouch

    if isMouse or isTouch then
        local delta = input.Position - dragStart

        targetPosition = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or (activeTouch ~= nil and input == activeTouch) then

        dragging = false
        activeTouch = nil
    end
end)

local renderConnection

renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
    if not Gui.Parent or not Frame.Parent then
        renderConnection:Disconnect()
        return
    end

    local alpha = 1 - math.exp(-GLIDE_SPEED * deltaTime)
    local current = Frame.Position

    Frame.Position = UDim2.new(
        current.X.Scale
            + (targetPosition.X.Scale - current.X.Scale) * alpha,
        current.X.Offset
            + (targetPosition.X.Offset - current.X.Offset) * alpha,
        current.Y.Scale
            + (targetPosition.Y.Scale - current.Y.Scale) * alpha,
        current.Y.Offset
            + (targetPosition.Y.Offset - current.Y.Offset) * alpha
    )

    Shadow.Position = UDim2.new(
        Frame.Position.X.Scale,
        Frame.Position.X.Offset,
        Frame.Position.Y.Scale,
        Frame.Position.Y.Offset + 8
    )

    if not dragging then
        local dx = math.abs(
            targetPosition.X.Offset - Frame.Position.X.Offset
        )

        local dy = math.abs(
            targetPosition.Y.Offset - Frame.Position.Y.Offset
        )

        if dx < POSITION_EPSILON and dy < POSITION_EPSILON then
            Frame.Position = targetPosition
        end
    end
end)

